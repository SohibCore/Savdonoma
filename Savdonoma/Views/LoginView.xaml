<UserControl x:Class="Savdonoma.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1200"
             Background="#F2F6FF">
    <UserControl.Resources>
        <Style x:Key="AuthTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="46" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#172554" />
            <Setter Property="CaretBrush" Value="#2563EB" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="InputBorder" Background="#FFFFFF"
                                    BorderBrush="#DCE6F8" BorderThickness="1"
                                    CornerRadius="12" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="15,0"
                                          VerticalAlignment="Center" />
                            <TextBlock x:Name="Placeholder"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="#91A1BF" FontSize="14"
                                       Margin="16,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#B9CBED" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#3978F6" />
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AuthPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="46" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#172554" />
            <Setter Property="CaretBrush" Value="#2563EB" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Grid>
                            <Border x:Name="InputBorder" Background="#FFFFFF"
                                    BorderBrush="#DCE6F8" BorderThickness="1"
                                    CornerRadius="12" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="15,0"
                                          VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#B9CBED" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#3978F6" />
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RegistrationFieldStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRegistration}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LoginOnlyPanelStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRegistration}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Ellipse Width="540" Height="540" Fill="#E3ECFF"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-280,0,0,-300" />
        <Ellipse Width="460" Height="460" Fill="#EAF1FF"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-280,-240,0" />

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border MaxWidth="1080" MinWidth="980" MinHeight="588"
                    Margin="30,28" HorizontalAlignment="Center"
                    Background="White" CornerRadius="24"
                    BorderBrush="#E4EBF8" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#7893C7" BlurRadius="34"
                                      ShadowDepth="10" Opacity="0.16" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.58*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Border Background="#FFFFFF" CornerRadius="24,0,0,24" />
                        <Grid Margin="34,30,34,24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="58" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="54" Height="54" CornerRadius="16">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#1680FF" Offset="0" />
                                                <GradientStop Color="#1748E8" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="TU" FontSize="21" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="27" FontWeight="Bold"
                                                   Foreground="#0F1E42">
                                            <Run Text="Tijorat " />
                                            <Run Text="Uz" Foreground="#1763F5" />
                                        </TextBlock>
                                        <TextBlock FontSize="14" Foreground="#6B7C9F"
                                                   Margin="0,1,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Tizimga kirish" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRegistration}" Value="True">
                                                            <Setter Property="Text" Value="Do‘konni ro‘yxatdan o‘tkazish" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                                <Border Height="1" Background="#E5ECF8" Margin="0,24,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center"
                                        HorizontalAlignment="Center" MaxWidth="330"
                                        Margin="0,22,0,20">
                                <StackPanel Margin="0,0,0,13" Style="{StaticResource RegistrationFieldStyle}">
                                    <TextBlock Text="Do‘kon nomi" Foreground="#172554"
                                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,7" />
                                    <TextBox Style="{StaticResource AuthTextBoxStyle}" Tag="Do‘kon nomi"
                                             Text="{Binding OrgName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,13" Style="{StaticResource RegistrationFieldStyle}">
                                    <TextBlock Text="INN" Foreground="#172554"
                                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,7" />
                                    <TextBox Style="{StaticResource AuthTextBoxStyle}" Tag="INN"
                                             MaxLength="20"
                                             Text="{Binding Inn, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,13" Style="{StaticResource RegistrationFieldStyle}">
                                    <TextBlock Text="Do‘kon manzili" Foreground="#172554"
                                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,7" />
                                    <TextBox Style="{StaticResource AuthTextBoxStyle}" Tag="Do‘kon manzili"
                                             MaxLength="500"
                                             Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,13" Style="{StaticResource RegistrationFieldStyle}">
                                    <TextBlock Text="Ism-familiya" Foreground="#172554"
                                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,7" />
                                    <TextBox Style="{StaticResource AuthTextBoxStyle}" Tag="Ism-familiyangiz"
                                             Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <TextBlock Foreground="#172554" FontSize="13"
                                           FontWeight="SemiBold" Margin="0,0,0,7">
                                    <Run Text="&#xE77B; " FontFamily="Segoe MDL2 Assets"
                                         Foreground="#172554" />
                                    <Run Text="Login" />
                                </TextBlock>
                                <TextBox Style="{StaticResource AuthTextBoxStyle}"
                                         Tag="Foydalanuvchi logini"
                                         Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,17" />

                                <TextBlock Foreground="#172554" FontSize="13"
                                           FontWeight="SemiBold" Margin="0,0,0,7">
                                    <Run Text="&#xE72E; " FontFamily="Segoe MDL2 Assets"
                                         Foreground="#172554" />
                                    <Run Text="Parol" />
                                </TextBlock>
                                <Grid Height="46" Margin="0,0,0,12">
                                    <PasswordBox x:Name="PasswordInput"
                                                 Style="{StaticResource AuthPasswordBoxStyle}"
                                                 PasswordChanged="PasswordInput_PasswordChanged" />
                                    <TextBlock x:Name="PasswordPlaceholder"
                                               Text="Parolingizni kiriting"
                                               Foreground="#91A1BF" FontSize="14"
                                               Margin="16,0" VerticalAlignment="Center"
                                               IsHitTestVisible="False" />
                                </Grid>

                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626"
                                           TextWrapping="Wrap" Margin="0,0,0,8" />
                                <Button Command="{Binding SubmitCommand}" IsDefault="True"
                                        Height="48" BorderThickness="0" Foreground="White"
                                        FontSize="15" FontWeight="SemiBold" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="IsEnabled" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#1477FF" Offset="0" />
                                            <GradientStop Color="#173BF0" Offset="1" />
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="13">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#2563EB" BlurRadius="14"
                                                                      ShadowDepth="5" Opacity="0.24" />
                                                </Border.Effect>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="→" FontSize="20"
                                                               Margin="0,0,12,2" />
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="Davom etish" />
                                </Button>

                                <TextBlock Text="{Binding InfoMessage}" Foreground="#15803D"
                                           TextWrapping="Wrap" Margin="0,10,0,0" />

                                <StackPanel Margin="0,14,0,0"
                                            Style="{StaticResource LoginOnlyPanelStyle}">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Height="1" Background="#E5ECF8"
                                                VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Yoki"
                                                   Foreground="#94A3B8" FontSize="12"
                                                   Margin="12,0" />
                                        <Border Grid.Column="2" Height="1"
                                                Background="#E5ECF8" VerticalAlignment="Center" />
                                    </Grid>
                                    <Button Content="ⓘ   Parolni unutdim?"
                                            Click="ForgotPassword_Click"
                                            Height="42" Background="White"
                                            Foreground="#1763F5" BorderBrush="#D6E3FF"
                                            BorderThickness="1" FontSize="13"
                                            FontWeight="SemiBold" Cursor="Hand" />
                                </StackPanel>

                                <TextBlock Text="Birinchi kirishda do‘kon egasi avtomatik yaratiladi."
                                           Foreground="#7586A7" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,12,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRegistration}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <Viewbox Grid.Row="2" Stretch="Fill" Opacity="0.72"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                                <Canvas Width="320" Height="58" ClipToBounds="True">
                                    <Rectangle Width="320" Height="7" Canvas.Top="51"
                                               Fill="#D8E6FF" />
                                    <Rectangle Width="27" Height="40" Canvas.Left="16" Canvas.Top="18"
                                               Fill="#DAE8FF" RadiusX="3" RadiusY="3" />
                                    <Rectangle Width="18" Height="49" Canvas.Left="45" Canvas.Top="9"
                                               Fill="#D1E2FF" />
                                    <Ellipse Width="24" Height="24" Canvas.Left="42" Canvas.Top="0"
                                             Fill="#D1E2FF" />
                                    <Rectangle Width="24" Height="40" Canvas.Left="42" Canvas.Top="18"
                                               Fill="#D1E2FF" />
                                    <Rectangle Width="43" Height="31" Canvas.Left="88" Canvas.Top="27"
                                               Fill="#D8E6FF" />
                                    <Polygon Points="84,28 109,10 135,28" Fill="#D8E6FF" />
                                    <Rectangle Width="6" Height="51" Canvas.Left="156" Canvas.Top="7"
                                               Fill="#C9DCFF" />
                                    <Polygon Points="153,8 159,0 165,8" Fill="#C9DCFF" />
                                    <Rectangle Width="44" Height="34" Canvas.Left="190" Canvas.Top="24"
                                               Fill="#D8E6FF" />
                                    <Polygon Points="185,25 212,6 239,25" Fill="#D8E6FF" />
                                    <Rectangle Width="7" Height="48" Canvas.Left="267" Canvas.Top="10"
                                               Fill="#C9DCFF" />
                                    <Polygon Points="263,11 270,0 277,11" Fill="#C9DCFF" />
                                    <Rectangle Width="30" Height="31" Canvas.Left="286" Canvas.Top="27"
                                               Fill="#DAE8FF" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Grid>

                    <Border Grid.Column="1" Margin="0" Padding="34,30"
                            CornerRadius="22" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#07183F" Offset="0" />
                                <GradientStop Color="#1034A6" Offset="0.58" />
                                <GradientStop Color="#2077F8" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Ellipse Width="540" Height="540" Fill="#1B3C9C"
                                     Opacity="0.28" HorizontalAlignment="Right"
                                     VerticalAlignment="Top" Margin="0,-180,-210,0" />
                            <Polygon Points="170,620 620,360 620,620"
                                     Fill="#347DFF" Opacity="0.2"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" />

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Width="56" Height="56" CornerRadius="15"
                                        Background="#FFFFFF" HorizontalAlignment="Left">
                                    <TextBlock Text="TU" FontSize="21" FontWeight="Bold"
                                               Foreground="#1763F5" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <Grid Grid.Row="1" Margin="0,22,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.02*" />
                                        <ColumnDefinition Width="0.98*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                                Margin="0,0,10,0">
                                        <TextBlock FontSize="30" FontWeight="Bold"
                                                   TextWrapping="Wrap">
                                            <Run Text="Biznesingiz uchun" Foreground="White" />
                                            <LineBreak />
                                            <Run Text="qulay " Foreground="#FFFFFF" />
                                            <Run Text="boshqaruv" Foreground="#7DD3FC" />
                                        </TextBlock>
                                        <TextBlock Text="Savdo jarayonlarini sodda va tartibli boshqaring."
                                                   FontSize="14" Foreground="#D7E5FF"
                                                   TextWrapping="Wrap" Margin="0,14,0,20" />

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <Border Width="36" Height="36" CornerRadius="18"
                                                    Background="#1855CC" Margin="0,0,12,0">
                                                <TextBlock Text="▥" FontSize="18" Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="Savdo va cheklar nazorati"
                                                       FontSize="13" Foreground="White"
                                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <Border Width="36" Height="36" CornerRadius="18"
                                                    Background="#1855CC" Margin="0,0,12,0">
                                                <TextBlock Text="◇" FontSize="20" Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="Mahsulotlar va ombor hisobi"
                                                       FontSize="13" Foreground="White"
                                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="36" Height="36" CornerRadius="18"
                                                    Background="#1855CC" Margin="0,0,12,0">
                                                <TextBlock Text="●" FontSize="16" Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="Tushunarli hisobotlar"
                                                       FontSize="13" Foreground="White"
                                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Viewbox Grid.Column="1" Width="280" Height="270"
                                             Stretch="Uniform" VerticalAlignment="Center"
                                             HorizontalAlignment="Right">
                                        <Canvas Width="300" Height="270">
                                            <Ellipse Width="230" Height="150"
                                                     Canvas.Left="32" Canvas.Top="92"
                                                     Fill="#2D67E2" Opacity="0.28" />

                                            <Polygon Points="203,30 249,11 296,30 252,49"
                                                     Fill="#244EC1" Stroke="#5F8EFF"
                                                     StrokeThickness="1.5" />
                                            <Polygon Points="225,30 252,42 280,30 252,48"
                                                     Fill="#193A97" Opacity="0.9" />
                                            <Line X1="278" Y1="30" X2="291" Y2="48"
                                                  Stroke="#FFC857" StrokeThickness="2.5" />
                                            <Ellipse Width="7" Height="7" Canvas.Left="287"
                                                     Canvas.Top="45" Fill="#FFC857" />

                                            <Border Width="228" Height="148"
                                                    Canvas.Left="34" Canvas.Top="57"
                                                    CornerRadius="12" Background="#F9FBFF"
                                                    BorderBrush="#83B5FF" BorderThickness="4">
                                                <Grid Margin="10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="20" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Ellipse Width="5" Height="5" Fill="#4F86F7" />
                                                        <Ellipse Width="5" Height="5" Fill="#A9C6FF"
                                                                 Margin="4,0,0,0" />
                                                        <Border Height="4" Width="54" CornerRadius="2"
                                                                Background="#DCE7FA" Margin="10,0,0,0" />
                                                    </StackPanel>
                                                    <Grid Grid.Row="1" Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="34" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <Border Height="5" Width="23" CornerRadius="2"
                                                                    Background="#D5E2F8" Margin="0,3" />
                                                            <Border Height="5" Width="18" CornerRadius="2"
                                                                    Background="#D5E2F8" Margin="0,4" />
                                                            <Border Height="5" Width="21" CornerRadius="2"
                                                                    Background="#D5E2F8" Margin="0,4" />
                                                        </StackPanel>
                                                        <Grid Grid.Column="1" ClipToBounds="True">
                                                            <Border BorderBrush="#E9EFF9"
                                                                    BorderThickness="0,0,0,1"
                                                                    Height="22" VerticalAlignment="Top" />
                                                            <Border BorderBrush="#E9EFF9"
                                                                    BorderThickness="0,0,0,1"
                                                                    Height="44" VerticalAlignment="Top" />
                                                            <Border BorderBrush="#E9EFF9"
                                                                    BorderThickness="0,0,0,1"
                                                                    Height="66" VerticalAlignment="Top" />
                                                            <Polyline Points="2,70 29,53 54,61 82,29 108,40 145,15"
                                                                      Stroke="#3784F6" StrokeThickness="2.5" />
                                                            <Rectangle Width="9" Height="23" Fill="#9CC8FF"
                                                                       HorizontalAlignment="Left"
                                                                       VerticalAlignment="Bottom" Margin="13,0,0,0" />
                                                            <Rectangle Width="9" Height="35" Fill="#79AEFF"
                                                                       HorizontalAlignment="Left"
                                                                       VerticalAlignment="Bottom" Margin="39,0,0,0" />
                                                            <Rectangle Width="9" Height="46" Fill="#4B8BF3"
                                                                       HorizontalAlignment="Left"
                                                                       VerticalAlignment="Bottom" Margin="65,0,0,0" />
                                                            <Rectangle Width="9" Height="30" Fill="#9CC8FF"
                                                                       HorizontalAlignment="Left"
                                                                       VerticalAlignment="Bottom" Margin="91,0,0,0" />
                                                            <Rectangle Width="9" Height="53" Fill="#4B8BF3"
                                                                       HorizontalAlignment="Left"
                                                                       VerticalAlignment="Bottom" Margin="117,0,0,0" />
                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <Polygon Points="24,207 272,207 294,234 4,234"
                                                     Fill="#7AAEFF" Stroke="#B8D5FF"
                                                     StrokeThickness="1.5" />
                                            <Polygon Points="40,211 257,211 270,226 27,226"
                                                     Fill="#4A7FE0" Opacity="0.95" />
                                            <Border Width="48" Height="4" CornerRadius="2"
                                                    Canvas.Left="126" Canvas.Top="215"
                                                    Background="#A8CCFF" />
                                            <Ellipse Width="182" Height="12"
                                                     Canvas.Left="62" Canvas.Top="237"
                                                     Fill="#07183F" Opacity="0.28" />
                                        </Canvas>
                                    </Viewbox>
                                </Grid>

                                <StackPanel Grid.Row="2" Orientation="Horizontal"
                                            VerticalAlignment="Bottom">
                                    <Border Width="26" Height="26" CornerRadius="13"
                                            Background="#2455B8" Margin="0,0,10,0">
                                        <TextBlock Text="✓" FontSize="14" Foreground="#DCEBFF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="TijoratUz  ·  Savdo boshqaruvi"
                                               FontSize="11" Foreground="#C3D7FF"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
