<UserControl x:Class="Savdonoma.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="460">
    <Grid Background="#F1F5F9">
        <Border Width="390" Padding="30" Background="White" CornerRadius="18"
                BorderBrush="#E2E8F0" BorderThickness="3"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="TijoratUz" FontSize="28" FontWeight="Bold"
                           Foreground="#0F172A" HorizontalAlignment="Center" />
                <TextBlock Text="Do‘kon egasini ro‘yxatdan o‘tkazish"
                           FontSize="20" FontWeight="SemiBold" Foreground="#0F172A"
                           HorizontalAlignment="Center" Margin="0,8,0,22">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRegistration}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="Tizimga kirish"
                           FontSize="20" FontWeight="SemiBold" Foreground="#0F172A"
                           HorizontalAlignment="Center" Margin="0,8,0,22">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRegistration}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Do‘kon nomi" Foreground="#475569" Margin="0,0,0,5" />
                    <TextBox Text="{Binding OrgName, UpdateSourceTrigger=PropertyChanged}"
                             Height="38" Padding="9,6" />
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRegistration}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Ism-familiya" Foreground="#475569" Margin="0,0,0,5" />
                    <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                             Height="38" Padding="9,6" />
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRegistration}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                </StackPanel>

                <TextBlock Text="Login" Foreground="#475569" Margin="0,0,0,5" />
                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                         Height="38" Padding="9,6" Margin="0,0,0,12" />
                <TextBlock Text="Parol" Foreground="#475569" Margin="0,0,0,5" />
                <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordInput_PasswordChanged"
                             Height="38" Padding="9,6" Margin="0,0,0,16" />

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626"
                           TextWrapping="Wrap" Margin="0,0,0,12" />
                <Button Content="Davom etish" Command="{Binding SubmitCommand}"
                        Height="42" Background="#2563EB" Foreground="White"
                        BorderThickness="0" FontWeight="SemiBold">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Text="Birinchi kirishda do‘kon egasi avtomatik yaratiladi."
                           Foreground="#64748B" FontSize="12" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,14,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRegistration}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
