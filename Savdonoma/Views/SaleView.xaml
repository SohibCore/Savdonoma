<UserControl x:Class="Savdonoma.Views.SaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1200">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="PrimaryText" Color="#0F172A" />
        <SolidColorBrush x:Key="SecondaryText" Color="#64748B" />
        <SolidColorBrush x:Key="LightBackground" Color="#F8FAFC" />
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="TableHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Padding" Value="6,8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <!-- TableRowStyle global App.xaml dan keladi -->
        <Style x:Key="KeypadButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="LetterKeyStyle" TargetType="Button" BasedOn="{StaticResource KeypadButtonStyle}">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="KeyBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="KeyBorder" Property="Background" Value="#DBEAFE" />
                                <Setter TargetName="KeyBorder" Property="BorderBrush" Value="#60A5FA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="KeyBorder" Property="Background" Value="#BFDBFE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CartActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#EFF6FF" />
            <Setter Property="Foreground" Value="#1D4ED8" />
            <Setter Property="BorderBrush" Value="#BFDBFE" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DBEAFE" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#60A5FA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#BFDBFE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RemoveCartItemButtonStyle" TargetType="Button"
               BasedOn="{StaticResource CartActionButtonStyle}">
            <Setter Property="Background" Value="#FEF2F2" />
            <Setter Property="Foreground" Value="#B91C1C" />
            <Setter Property="BorderBrush" Value="#FECACA" />
            <Setter Property="FontSize" Value="19" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1.1*" />
            <RowDefinition Height="1.4*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}"
                Background="#E2E8F0" Margin="0,0,10,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Savat" FontSize="19" FontWeight="Bold" Foreground="{StaticResource PrimaryText}" />
                        <TextBlock Text="Tanlangan mahsulotlar va miqdorlar"
                                   FontSize="12" Foreground="{StaticResource SecondaryText}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="8" Padding="10,6"
                            VerticalAlignment="Center">
                        <TextBlock Text="SOTUV" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8" />
                    </Border>
                </Grid>

                <!-- Savat header -->
                <Grid Grid.Row="1" MinHeight="38" Background="#E9EEF5"
                      Width="{Binding ActualWidth, ElementName=CartList}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.8*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="#D5DDE8" BorderThickness="0,0,1,1" Padding="8,6">
                        <TextBlock Text="MAHSULOT" FontWeight="SemiBold" FontSize="11" Foreground="#111827" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1" BorderBrush="#D5DDE8" BorderThickness="0,0,1,1" Padding="8,6">
                        <TextBlock Text="NARX" FontWeight="SemiBold" FontSize="11" Foreground="#111827" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="2" BorderBrush="#D5DDE8" BorderThickness="0,0,1,1" Padding="8,6">
                        <TextBlock Text="MIQDOR" FontWeight="SemiBold" FontSize="11" Foreground="#111827" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="3" BorderBrush="#D5DDE8" BorderThickness="0,0,1,1" Padding="8,6">
                        <TextBlock Text="SUMMA" FontWeight="SemiBold" FontSize="11" Foreground="#111827" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="4" BorderBrush="#D5DDE8" BorderThickness="0,0,0,1" Padding="8,6">
                        <TextBlock Text="AMALLAR" FontWeight="SemiBold" FontSize="11" Foreground="#111827" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Savat ro'yxati -->
                <ListView x:Name="CartList" Grid.Row="2" ItemsSource="{Binding CartItems}"
                          SelectedItem="{Binding SelectedCartItem, Mode=TwoWay}" SelectionMode="Single"
                          FontSize="13"
                          BorderThickness="0" Background="Transparent" Padding="0"
                          ScrollViewer.CanContentScroll="False"
                          VirtualizingPanel.IsVirtualizing="False"
                          ItemContainerStyle="{StaticResource TableRowStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="40" Width="{Binding ActualWidth, ElementName=CartList}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.8*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" BorderBrush="#DCE3EC" BorderThickness="0,0,1,0" Padding="8,4">
                                    <TextBlock Text="{Binding ProductName}" VerticalAlignment="Center"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Border Grid.Column="1" BorderBrush="#DCE3EC" BorderThickness="0,0,1,0" Padding="8,4">
                                    <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N0}}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />
                                </Border>
                                <Border Grid.Column="2" BorderBrush="#DCE3EC" BorderThickness="0,0,1,0" Padding="4,4">
                                    <TextBox Text="{Binding QuantityText}"
                                             FontSize="13" Padding="3,4"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Center" TextAlignment="Center"
                                             BorderThickness="1" BorderBrush="#CBD5E1" />
                                </Border>
                                <Border Grid.Column="3" BorderBrush="#DCE3EC" BorderThickness="0,0,1,0" Padding="8,4">
                                    <TextBlock Text="{Binding LineTotal, StringFormat={}{0:N0}}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               TextAlignment="Center" FontWeight="SemiBold" />
                                </Border>
                                <Border Grid.Column="4" Padding="4,4">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="−" Style="{StaticResource CartActionButtonStyle}"
                                                ToolTip="Miqdorni kamaytirish"
                                                Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="+" Style="{StaticResource CartActionButtonStyle}"
                                                ToolTip="Miqdorni oshirish"
                                                Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="×" Style="{StaticResource RemoveCartItemButtonStyle}"
                                                ToolTip="Mahsulotni savatdan olib tashlash"
                                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}"
                Background="#E2E8F0" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Mahsulotlar" FontSize="19" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryText}" />
                    <TextBlock Text="Ro'yxatdan mahsulot tanlab savatga qo'shing"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryText}" Margin="0,2,0,0" />
                </StackPanel>
                <ui:TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Nomi yoki shtrix-kod bo'yicha qidirish"
                            FontSize="13" MinHeight="38" Margin="0,0,0,8" />

                <!-- Mahsulotlar jadval header -->
                <Grid Grid.Row="2" MinHeight="38" Background="#E9EEF5"
                      Width="{Binding ActualWidth, ElementName=SaleProductsList}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="#D5DDE8" BorderThickness="0,0,1,1" Padding="8,6">
                        <TextBlock Text="NOMI" FontWeight="SemiBold" FontSize="11" Foreground="#111827" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1" BorderBrush="#D5DDE8" BorderThickness="0,0,1,1" Padding="8,6">
                        <TextBlock Text="QOLDIQ" FontWeight="SemiBold" FontSize="11" Foreground="#111827" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="2" BorderBrush="#D5DDE8" BorderThickness="0,0,1,1" Padding="8,6">
                        <TextBlock Text="NARX" FontWeight="SemiBold" FontSize="11" Foreground="#111827" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="3" BorderBrush="#D5DDE8" BorderThickness="0,0,1,1" Padding="8,6">
                        <TextBlock Text="BIRLIK" FontWeight="SemiBold" FontSize="11" Foreground="#111827" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="4" BorderBrush="#D5DDE8" BorderThickness="0,0,0,1" Padding="8,6">
                        <TextBlock Text="SHTRIX-KOD" FontWeight="SemiBold" FontSize="11" Foreground="#111827" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Mahsulotlar ro'yxati -->
                <ListView x:Name="SaleProductsList" Grid.Row="3" ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProduct, Mode=TwoWay}" SelectionMode="Single"
                          FontSize="14" FontWeight="SemiBold"
                          BorderThickness="0" Padding="0" Background="Transparent"
                          ScrollViewer.CanContentScroll="False"
                          VirtualizingPanel.IsVirtualizing="False"
                          ItemContainerStyle="{StaticResource TableRowStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="38" Width="{Binding ActualWidth, ElementName=SaleProductsList}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1.5*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" BorderBrush="#DCE3EC" BorderThickness="0,0,1,0" Padding="8,4">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Border Grid.Column="1" BorderBrush="#DCE3EC" BorderThickness="0,0,1,0" Padding="8,4">
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Quantity, StringFormat={}{0:0.##}}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.InventoryEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                 Value="False">
                                                        <Setter Property="Text" Value="—" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Border Grid.Column="2" BorderBrush="#DCE3EC" BorderThickness="0,0,1,0" Padding="8,4">
                                    <TextBlock Text="{Binding Price, StringFormat={}{0:N0}}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />
                                </Border>
                                <Border Grid.Column="3" BorderBrush="#DCE3EC" BorderThickness="0,0,1,0" Padding="8,4">
                                    <TextBlock Text="{Binding Unit}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />
                                </Border>
                                <Border Grid.Column="4" Padding="8,4">
                                    <TextBlock Text="{Binding Barcode}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Border Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource CardStyle}"
                Background="#E2E8F0" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Savdo amallari" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryText}" />
                        <TextBlock Text="Klaviatura, to'lov va summa"
                                   FontSize="11" Foreground="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding ToggleKeyboardLayoutCommand}"
                            MinWidth="48" MinHeight="32" Padding="6,2" VerticalAlignment="Center"
                            ToolTip="Harfli klaviaturani yoqish yoki o'chirish">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="ABC" />
                                <Setter Property="Background" Value="#F1F5F9" />
                                <Setter Property="BorderBrush" Value="#E2E8F0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAlphabeticKeyboard}" Value="True">
                                        <Setter Property="Content" Value="123" />
                                        <Setter Property="Background" Value="#EDE9FE" />
                                        <Setter Property="Foreground" Value="#6D28D9" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Miqdor" MinHeight="44" Padding="4,7" FontSize="11"
                            Command="{Binding SelectQuantityEntryModeCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#F1F5F9" />
                                <Setter Property="BorderBrush" Value="#E2E8F0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsQuantityEntryMode}" Value="True">
                                        <Setter Property="Background" Value="#DBEAFE" />
                                        <Setter Property="Foreground" Value="#1D4ED8" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="1" Content="Qidirish" MinHeight="44" Padding="4,7" FontSize="11"
                            ToolTip="Klaviatura orqali mahsulot nomi yoki shtrix-kodi bo'yicha qidirish"
                            Command="{Binding SelectSearchModeCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#F1F5F9" />
                                <Setter Property="BorderBrush" Value="#E2E8F0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsQuantityEntryMode}" Value="False" />
                                            <Condition Binding="{Binding IsReceivedAmountEntryMode}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="#DBEAFE" />
                                        <Setter Property="Foreground" Value="#1D4ED8" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="2" Content="To'lov" MinHeight="44" Padding="4,7" FontSize="11"
                            Visibility="{Binding IsCash, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="Klaviatura orqali mijozdan olingan summani kiriting"
                            Command="{Binding SelectReceivedAmountEntryModeCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#F1F5F9" />
                                <Setter Property="BorderBrush" Value="#E2E8F0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReceivedAmountEntryMode}" Value="True">
                                        <Setter Property="Background" Value="#DCFCE7" />
                                        <Setter Property="Foreground" Value="#15803D" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryText}" Margin="0,0,0,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="MIQDOR / QIDIRUV" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReceivedAmountEntryMode}" Value="True">
                                        <Setter Property="Text" Value="MIJOZDAN OLINGAN SUMMA" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding KeypadInput, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="17" FontWeight="SemiBold" MinHeight="40" Padding="10,5"
                                 HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                 BorderBrush="#CBD5E1" ToolTip="Miqdor yoki qidiruv matni">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReceivedAmountEntryMode}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBox Grid.Column="0" Text="{Binding ReceivedAmountText, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="17" FontWeight="SemiBold" MinHeight="40" Padding="10,5"
                                 HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                 BorderBrush="#CBD5E1" ToolTip="Mijoz bergan naqd pul miqdori">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReceivedAmountEntryMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Grid.Column="1" Content="⌫" FontSize="14" Margin="4,0,0,0"
                                Command="{Binding BackspaceKeypadInputCommand}"
                                ToolTip="Oxirgi belgini o'chirish">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReceivedAmountEntryMode}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="1" Content="C" FontSize="14" Margin="4,0,0,0"
                                Command="{Binding ClearKeypadInputCommand}"
                                ToolTip="Mijoz kiritgan summani tozalash">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReceivedAmountEntryMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Grid>

                <Grid Grid.Row="3" Margin="0,0,0,6">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAlphabeticKeyboard}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Row="0" Grid.Column="0" Content="7" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AddKeyCommand}" CommandParameter="7" />
                    <Button Grid.Row="0" Grid.Column="1" Content="8" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AddKeyCommand}" CommandParameter="8" />
                    <Button Grid.Row="0" Grid.Column="2" Content="9" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AddKeyCommand}" CommandParameter="9" />
                    <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AddKeyCommand}" CommandParameter="4" />
                    <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AddKeyCommand}" CommandParameter="5" />
                    <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AddKeyCommand}" CommandParameter="6" />
                    <Button Grid.Row="2" Grid.Column="0" Content="1" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AddKeyCommand}" CommandParameter="1" />
                    <Button Grid.Row="2" Grid.Column="1" Content="2" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AddKeyCommand}" CommandParameter="2" />
                    <Button Grid.Row="2" Grid.Column="2" Content="3" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AddKeyCommand}" CommandParameter="3" />
                    <Button Grid.Row="3" Grid.Column="0" Content="C" FontSize="16"
                            Style="{StaticResource KeypadButtonStyle}"
                            Command="{Binding ClearKeypadInputCommand}" />
                    <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource KeypadButtonStyle}"
                            Command="{Binding AddKeyCommand}" CommandParameter="0" />
                    <Button Grid.Row="3" Grid.Column="2" Command="{Binding AddKeyCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource KeypadButtonStyle}">
                                <Setter Property="Content" Value="000" />
                                <Setter Property="FontSize" Value="21" />
                                <Setter Property="CommandParameter" Value="000" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKgQuantityEntryMode}" Value="True">
                                        <Setter Property="Content" Value="." />
                                        <Setter Property="FontSize" Value="28" />
                                        <Setter Property="CommandParameter" Value="." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,0,0,6">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAlphabeticKeyboard}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <UniformGrid Columns="10">
                        <Button Content="Q" Style="{StaticResource LetterKeyStyle}" Command="{Binding AddKeyCommand}" CommandParameter="q" />
                        <Button Content="W" Style="{StaticResource LetterKeyStyle}" Command="{Binding AddKeyCommand}" CommandParameter="w" />
                        <Button Content="E" Style="{StaticResource LetterKeyStyle}" Command="{Binding AddKeyCommand}" CommandParameter="e" />
                        <Button Content="R" Style="{StaticResource LetterKeyStyle}" Command="{Binding AddKeyCommand}" CommandParameter="r" />
                        <Button Content="T" Style="{StaticResource LetterKeyStyle}" Command="{Binding AddKeyCommand}" CommandParameter="t" />
                        <Button Content="Y" Style="{StaticResource LetterKeyStyle}" Command="{Binding AddKeyCommand}" CommandParameter="y" />
                        <Button Content="U" Style="{StaticResource LetterKeyStyle}" Command="{Binding AddKeyCommand}" CommandParameter="u" />
                        <Button Content="I" Style="{StaticResource LetterKeyStyle}" Command="{Binding AddKeyCommand}" CommandParameter="i" />
                        <Button Content="O" Style="{StaticResource LetterKeyStyle}" Command="{Binding AddKeyCommand}" CommandParameter="o" />
                        <Button Content="P" Style="{StaticResource LetterKeyStyle}" Command="{Binding AddKeyCommand}" CommandParameter="p" />
                    </UniformGrid>
                    <UniformGrid Columns="9">
                        <Button Content="A" Style="{StaticResource LetterKeyStyle}" Command="{Binding AddKeyCommand}" CommandParameter="a" />
                        <Button Content="S" Style="{StaticResource LetterKeyStyle}" Command="{Binding AddKeyCommand}" CommandParameter="s" />
                        <Button Content="D" Style="{StaticResource LetterKeyStyle}" Command="{Binding AddKeyCommand}" CommandParameter="d" />
                        <Button Content="F" Style="{StaticResource LetterKeyStyle}" Command="{Binding AddKeyCommand}" CommandParameter="f" />
                        <Button Content="G" Style="{StaticResource LetterKeyStyle}" Command="{Binding AddKeyCommand}" CommandParameter="g" />
                        <Button Content="H" Style="{StaticResource LetterKeyStyle}" Command="{Binding AddKeyCommand}" CommandParameter="h" />
                        <Button Content="J" Style="{StaticResource LetterKeyStyle}" Command="{Binding AddKeyCommand}" CommandParameter="j" />
                        <Button Content="K" Style="{StaticResource LetterKeyStyle}" Command="{Binding AddKeyCommand}" CommandParameter="k" />
                        <Button Content="L" Style="{StaticResource LetterKeyStyle}" Command="{Binding AddKeyCommand}" CommandParameter="l" />
                    </UniformGrid>
                    <UniformGrid Columns="7">
                        <Button Content="Z" Style="{StaticResource LetterKeyStyle}" Command="{Binding AddKeyCommand}" CommandParameter="z" />
                        <Button Content="X" Style="{StaticResource LetterKeyStyle}" Command="{Binding AddKeyCommand}" CommandParameter="x" />
                        <Button Content="C" Style="{StaticResource LetterKeyStyle}" Command="{Binding AddKeyCommand}" CommandParameter="c" />
                        <Button Content="V" Style="{StaticResource LetterKeyStyle}" Command="{Binding AddKeyCommand}" CommandParameter="v" />
                        <Button Content="B" Style="{StaticResource LetterKeyStyle}" Command="{Binding AddKeyCommand}" CommandParameter="b" />
                        <Button Content="N" Style="{StaticResource LetterKeyStyle}" Command="{Binding AddKeyCommand}" CommandParameter="n" />
                        <Button Content="M" Style="{StaticResource LetterKeyStyle}" Command="{Binding AddKeyCommand}" CommandParameter="m" />
                    </UniformGrid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Bo'sh joy" FontSize="11" Style="{StaticResource LetterKeyStyle}" Command="{Binding AddKeyCommand}" CommandParameter=" " />
                        <Button Grid.Column="1" Content="⌫" FontSize="14" Style="{StaticResource LetterKeyStyle}" Command="{Binding BackspaceKeypadInputCommand}" />
                        <Button Grid.Column="2" Content="Tozalash" FontSize="11" Style="{StaticResource LetterKeyStyle}" Command="{Binding ClearKeypadInputCommand}" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,0,0,14">
                    <Button Content="MIQDORNI QO'LLASH"
                            Command="{Binding ApplyKeypadInputCommand}"
                            MinHeight="38" FontSize="12" FontWeight="SemiBold"
                            Background="#DBEAFE" Foreground="#1D4ED8" BorderThickness="0"
                            Margin="0,0,0,8">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsQuantityEntryMode}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="TO'LOV TURI" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryText}" Margin="0,0,0,5" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Naqd" MinHeight="38" Margin="0,0,3,0"
                                Command="{Binding SelectCashPaymentMethodCommand}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#F1F5F9" />
                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCash}" Value="True">
                                            <Setter Property="Background" Value="#DBEAFE" />
                                            <Setter Property="Foreground" Value="#1D4ED8" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="1" Content="Karta" MinHeight="38" Margin="3,0,0,0"
                                Command="{Binding SelectCardPaymentMethodCommand}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#F1F5F9" />
                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCash}" Value="False">
                                            <Setter Property="Background" Value="#DBEAFE" />
                                            <Setter Property="Foreground" Value="#1D4ED8" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <StackPanel Margin="0,0,0,8">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCash}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1"
                                CornerRadius="8" Padding="8" Margin="0,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Qaytim:" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#047857" />
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUnderpaid}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Yetishmaydi:" FontSize="10" Foreground="#B45309" />
                                        <TextBlock Text="{Binding RemainingAmount, StringFormat={}{0:N0}}"
                                                   FontSize="10" FontWeight="SemiBold" Foreground="#B45309"
                                                   Margin="4,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Change, StringFormat={}{0:N0}}"
                                               FontSize="17" FontWeight="Bold" Foreground="#047857" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                            CornerRadius="8" Padding="8" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C"
                                   TextWrapping="Wrap" FontSize="11" />
                    </Border>
                    <Border Background="{StaticResource LightBackground}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="JAMI" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N0}}"
                                           FontSize="21" FontWeight="Bold" Foreground="{StaticResource PrimaryText}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text=" so'm" FontSize="11" Foreground="{StaticResource SecondaryText}"
                                           VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ui:Button Content="SOTUVNI YAKUNLASH"
                           Command="{Binding CompleteSaleCommand}" Appearance="Primary"
                           MinHeight="42" FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Stretch" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
