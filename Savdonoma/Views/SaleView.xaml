<UserControl x:Class="Savdonoma.Views.SaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1200">

    <UserControl.Resources>

        <!-- ============================= -->
        <!-- COLORS                         -->
        <!-- ============================= -->

        <SolidColorBrush x:Key="CardBackground"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#E5E7EB"/>

        <SolidColorBrush x:Key="PrimaryText"
                         Color="#111827"/>

        <SolidColorBrush x:Key="SecondaryText"
                         Color="#6B7280"/>

        <SolidColorBrush x:Key="DangerText"
                         Color="#DC2626"/>

        <SolidColorBrush x:Key="LightBackground"
                         Color="#F9FAFB"/>


        <!-- ============================= -->
        <!-- CARD                           -->
        <!-- ============================= -->

        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{StaticResource CardBackground}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="12"/>

            <Setter Property="Padding"
                    Value="18"/>

        </Style>


        <!-- ============================= -->
        <!-- TABLE HEADER                   -->
        <!-- ============================= -->

        <Style x:Key="TableHeaderStyle"
               TargetType="GridViewColumnHeader">

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryText}"/>

            <Setter Property="Background"
                    Value="#F9FAFB"/>

            <Setter Property="Padding"
                    Value="8,10"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="BorderThickness"
                    Value="0,0,1,1"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

        </Style>


        <!-- ============================= -->
        <!-- TABLE TEXT                    -->
        <!-- ============================= -->

        <Style x:Key="TableTextStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryText}"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>


        <!-- ============================= -->
        <!-- FIELD LABEL                   -->
        <!-- ============================= -->

        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryText}"/>

            <Setter Property="Margin"
                    Value="0,0,0,6"/>

        </Style>


        <!-- ====================================================== -->
        <!-- TABLE CELL (CENTERED)                                -->
        <!-- ====================================================== -->

        <Style x:Key="TableCellStyle"
               TargetType="TextBlock">
            <Setter Property="HorizontalAlignment"
                    Value="Center"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryText}"/>
        </Style>

    </UserControl.Resources>


    <!-- ====================================================== -->
    <!-- MAIN                                                   -->
    <!-- ====================================================== -->

    <Grid Margin="20">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="*"/>

            <ColumnDefinition Width="470"/>

        </Grid.ColumnDefinitions>


        <!-- ================================================== -->
        <!-- LEFT: PRODUCTS                                    -->
        <!-- ================================================== -->

        <Border Grid.Column="0"
                Style="{StaticResource CardStyle}"
                Margin="0,0,16,0">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <!-- HEADER -->

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,16">
                    <TextBlock Text="Mahsulotlar"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryText}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Sotuv uchun mahsulot tanlang"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryText}"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>


                <!-- SEARCH -->

                <ui:TextBox Grid.Row="1"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Mahsulot nomi yoki shtrix-kod bo'yicha qidirish..."
                            FontSize="15"
                            MinHeight="44"
                            Margin="0,0,0,14"/>


                <!-- PRODUCTS TABLE -->

                <ListView x:Name="SaleProductsList"
                          Grid.Row="2"
                          ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                          SelectionMode="Single"
                          FontSize="14"
                          BorderThickness="0"
                          Padding="0"
                          Background="Transparent"
                          ItemContainerStyle="{StaticResource TableRowStyle}"
                          SizeChanged="SaleProductsList_SizeChanged">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource TableHeaderStyle}">
                            <GridViewColumn Header="MAHSULOT" Width="250">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Center"
                                                   Padding="6,10"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="NARX" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Price, StringFormat={}{0:N0}}"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Center"
                                                   Padding="6,10"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="BIRLIK" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Unit}"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Center"
                                                   Padding="6,10"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="SHtrix-kod" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Barcode}"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Center"
                                                   Padding="6,10"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <Canvas Grid.Row="2" IsHitTestVisible="False">
                    <Rectangle Canvas.Left="249" Width="1" Fill="{StaticResource BorderBrush}"
                               Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}"/>
                    <Rectangle Canvas.Left="379" Width="1" Fill="{StaticResource BorderBrush}"
                               Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}"/>
                    <Rectangle Canvas.Left="469" Width="1" Fill="{StaticResource BorderBrush}"
                               Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}"/>
                </Canvas>

            </Grid>

        </Border>


        <!-- ================================================== -->
        <!-- RIGHT: CART                                        -->
        <!-- ================================================== -->

        <Border Grid.Column="1"
                Style="{StaticResource CardStyle}">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- CART HEADER -->

                <Grid Grid.Row="0"
                      Margin="0,0,0,16">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Savat"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryText}"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Tanlangan mahsulotlar"
                                   FontSize="13"
                                   Foreground="{StaticResource SecondaryText}"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Grid>


                <!-- CART TABLE -->

                <ListView Grid.Row="1"
                          ItemsSource="{Binding CartItems}"
                          FontSize="14"
                          BorderThickness="0"
                          Background="Transparent"
                          ItemContainerStyle="{StaticResource TableRowStyle}">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource TableHeaderStyle}">
                            <GridViewColumn Header="MAHSULOT" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProductName}"
                                   HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="MIQDOR" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding QuantityText}"
                                 FontSize="14"
                                 MinWidth="60"
                                 VerticalAlignment="Center"
                                 TextAlignment="Center"
                                 BorderThickness="1"
                                 BorderBrush="#D1D5DB"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="SUMMA" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LineTotal, StringFormat={}{0:N0}}"
                                   HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="AMAL" Width="82">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="-"
                                    Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding}"
                                    Width="28"
                                    Height="28"
                                    FontSize="16"
                                    FontWeight="Bold"/>
                                            <Button Content="+"
                                    Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding}"
                                    Width="28"
                                    Height="28"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>


                <!-- ================================================== -->
                <!-- CHECKOUT                                           -->
                <!-- ================================================== -->

                <StackPanel Grid.Row="2"
                            Margin="0,16,0,0">


                    <!-- ERROR -->

                    <Border Background="#FEF2F2"
                            BorderBrush="#FECACA"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,0,0,14">

                        <TextBlock
                            Text="{Binding ErrorMessage}"
                            Foreground="{StaticResource DangerText}"
                            TextWrapping="Wrap"
                            FontSize="13"/>

                    </Border>


                    <!-- PAYMENT -->

                    <TextBlock
                        Text="To'lov turi"
                        Style="{StaticResource FieldLabelStyle}"/>


                    <ComboBox
                        ItemsSource="{Binding PaymentMethods}"
                        SelectedItem="{Binding SelectedPaymentMethod}"
                        MinHeight="44"
                        FontSize="15"
                        Margin="0,0,0,16"/>


                    <!-- TOTAL -->

                    <Border Background="{StaticResource LightBackground}"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,0,0,14">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <TextBlock
                                Text="JAMI"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource SecondaryText}"
                                VerticalAlignment="Center"/>


                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding TotalAmount, StringFormat={}{0:N0}}"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="{StaticResource PrimaryText}"
                                HorizontalAlignment="Right"/>

                        </Grid>

                    </Border>


                    <!-- COMPLETE SALE -->

                    <ui:Button
                        Content="SOTUVNI YAKUNLASH"
                        Command="{Binding CompleteSaleCommand}"
                        Appearance="Primary"
                        MinHeight="52"
                        FontSize="17"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Stretch"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>
