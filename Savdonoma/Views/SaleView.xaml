<UserControl x:Class="Savdonoma.Views.SaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000">

    <Grid Margin="16">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- Mahsulotlar -->
        <Grid Grid.Column="0"
              Margin="0,0,16,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:TextBox
                Grid.Row="0"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="Mahsulot nomi yoki shtrix-kod..."
                FontSize="16"
                MinHeight="44"
                Margin="0,0,0,12" />

            <DataGrid
                Grid.Row="1"
                ItemsSource="{Binding Products}"
                SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                SelectionMode="Single"
                RowHeight="44"
                FontSize="15">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="Nomi"
                        Binding="{Binding Name}"
                        Width="*" />

                    <DataGridTextColumn
                        Header="Narx"
                        Binding="{Binding Price, StringFormat={}{0:N0}}"
                        Width="120" />

                    <DataGridTextColumn
                        Header="Birlik"
                        Binding="{Binding Unit}"
                        Width="80" />

                    <DataGridTextColumn
                        Header="Barcode"
                        Binding="{Binding Barcode}"
                        Width="150" />

                </DataGrid.Columns>

            </DataGrid>

        </Grid>

        <!-- Savat -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Text="Savat"
                FontSize="22"
                FontWeight="SemiBold"
                Margin="0,0,0,12" />

            <DataGrid
                Grid.Row="1"
                ItemsSource="{Binding CartItems}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                RowHeight="50">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="Mahsulot"
                        Binding="{Binding ProductName}"
                        Width="*" />

                    <DataGridTextColumn
                        Header="Miqdor"
                        Binding="{Binding Quantity}"
                        Width="70" />

                    <DataGridTextColumn
                        Header="Summa"
                        Binding="{Binding LineTotal, StringFormat={}{0:N0}}"
                        Width="110" />

                    <DataGridTemplateColumn
                        Header=""
                        Width="100">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <StackPanel
                                    Orientation="Horizontal">

                                    <Button
                                        Content="-"
                                        Command="{Binding DataContext.DecreaseQuantityCommand,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Width="30" />

                                    <Button
                                        Content="+"
                                        Command="{Binding DataContext.IncreaseQuantityCommand,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Width="30"
                                        Margin="4,0,0,0" />

                                </StackPanel>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

            <StackPanel Grid.Row="2">

                <TextBlock
                    Text="{Binding ErrorMessage}"
                    Foreground="#C42B1C"
                    TextWrapping="Wrap"
                    Margin="0,8" />

                <TextBlock
                    Text="To'lov turi"
                    Margin="0,4" />

                <ComboBox
                    ItemsSource="{Binding PaymentMethods}"
                    SelectedItem="{Binding SelectedPaymentMethod}"
                    MinHeight="40"
                    Margin="0,0,0,12" />

                <DockPanel Margin="0,0,0,12">

                    <TextBlock
                        Text="Jami:"
                        FontSize="20"
                        FontWeight="SemiBold" />

                    <TextBlock
    Text="{Binding TotalAmount}"
    FontSize="20"
    FontWeight="Bold"
    HorizontalAlignment="Right" />

                </DockPanel>

                <ui:Button
                    Content="SOTISH"
                    Command="{Binding CompleteSaleCommand}"
                    Appearance="Primary"
                    MinHeight="50"
                    FontSize="18" />

            </StackPanel>

        </Grid>

    </Grid>

</UserControl>