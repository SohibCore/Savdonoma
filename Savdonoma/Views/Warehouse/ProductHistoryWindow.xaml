<ui:FluentWindow x:Class="Savdonoma.Views.Warehouse.ProductHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:conv="clr-namespace:Savdonoma.Converters"
        Title="Mahsulot harakatlari"
        Icon="pack://application:,,,/TijoratUz;component/TijoratUz.ico"
        Width="980" Height="640" MinWidth="760" MinHeight="420"
        Background="#F1F5F9"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True">
    <ui:FluentWindow.Resources>
        <conv:DisplayNameConverter x:Key="DisplayName" />
        <conv:MoneyConverter x:Key="Money" />
        <conv:QuantityConverter x:Key="Qty" />
        <!-- Jadval yacheykalari: umumiy TableCellText (Styles/TableStyles.xaml) asosida -->
        <Style x:Key="RightCell" TargetType="TextBlock" BasedOn="{StaticResource TableCellText}" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="TijoratUz" />

        <StackPanel Grid.Row="1" Margin="20,8,20,12">
            <TextBlock x:Name="HeaderText" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock x:Name="SubText" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <DataGrid x:Name="MovementsGrid" Grid.Row="2" Margin="20,0,20,20" Style="{StaticResource TableGrid}" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sana" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}, Mode=OneWay}" Width="1.3*" ElementStyle="{StaticResource TableCellText}" />
                <DataGridTextColumn Header="Harakat" Binding="{Binding Type, Converter={StaticResource DisplayName}, Mode=OneWay}" Width="1.5*" ElementStyle="{StaticResource TableCellText}" />
                <DataGridTemplateColumn Header="Miqdor" Width="0.9*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Quantity, Converter={StaticResource Qty}, Mode=OneWay}"
                                       VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#15803D" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOut}" Value="True">
                                                <Setter Property="Foreground" Value="#DC2626" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Qoldiq" Binding="{Binding BalanceAfter, Converter={StaticResource Qty}, Mode=OneWay}" Width="0.9*"
                                    ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="Narx" Binding="{Binding CostPrice, Converter={StaticResource Money}, Mode=OneWay}" Width="1*"
                                    ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="Hujjat / chek" Binding="{Binding Reference, Mode=OneWay}" Width="1.6*" ElementStyle="{StaticResource TableCellText}" />
                <DataGridTextColumn Header="Izoh" Binding="{Binding Note, Mode=OneWay}" Width="2*" ElementStyle="{StaticResource TableCellText}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</ui:FluentWindow>
