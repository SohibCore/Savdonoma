<UserControl x:Class="Savdonoma.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1200">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Colors -->
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#111827"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#6B7280"/>
        <SolidColorBrush x:Key="DangerText" Color="#DC2626"/>

        <!-- Card -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <!-- Field label -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Table text -->
        <Style x:Key="TableTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Table header -->
        <Style x:Key="TableHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="20">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="370"/>
        </Grid.ColumnDefinitions>

        <!-- ====================================================== -->
        <!-- LEFT: PRODUCTS LIST                                   -->
        <!-- ====================================================== -->

        <Border Grid.Column="0"
                Style="{StaticResource CardStyle}"
                Background="#E2E8F0"
                Margin="0,0,16,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->

                <Grid Grid.Row="0"
                      Margin="0,0,0,16">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Mahsulotlar"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryText}"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Mahsulotlarni qidiring va boshqaring"
                                   FontSize="13"
                                   Foreground="{StaticResource SecondaryText}"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="Shablonni yuklab olish"
                                       Command="{Binding DownloadExcelTemplateCommand}"
                                       ToolTip="Mahsulot importi uchun Excel shablonini saqlash"
                                       MinHeight="40"
                                       Padding="12,0"
                                       Margin="0,0,8,0"/>
                            <ui:Button Content="Yangilash"
                                       Command="{Binding RefreshProductsCommand}"
                                       IsEnabled="{Binding CanRefreshProducts}"
                                       ToolTip="Mahsulotlar ro'yxatini yangilash"
                                       MinHeight="40"
                                       Padding="12,0"
                                       Margin="0,0,8,0"/>
                            <ui:Button Content="Excel'dan import"
                                       Command="{Binding ImportFromExcelCommand}"
                                       IsEnabled="{Binding CanImport}"
                                       ToolTip="Ustun sarlavhalari: Mahsulot, Qoldiq, Narx, Birlik, Shtrix-kod, KategoriyaId. KategoriyaId qiymati ixtiyoriy."
                                       MinHeight="40"
                                       Padding="12,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ImportStatus}"
                                   Foreground="{StaticResource SecondaryText}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   MaxWidth="210"
                                   HorizontalAlignment="Right"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                </Grid>

                <!-- Search -->

                <ui:TextBox Grid.Row="1"
                            PlaceholderText="Mahsulot nomi yoki shtrix-kod bo'yicha qidirish..."
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="15"
                            MinHeight="44"
                            Margin="0,0,0,14"
                            HorizontalAlignment="Center" Width="733"/>

                <!-- Products table header -->
                <Grid Grid.Row="2" MinHeight="42" Background="#E9EEF5"
                      Width="{Binding ActualWidth, ElementName=ProductsList}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="#D5DDE8" BorderThickness="0,0,1,1" Padding="12,8">
                        <TextBlock Text="MAHSULOT" FontWeight="SemiBold" Foreground="#111827"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1" BorderBrush="#D5DDE8" BorderThickness="0,0,1,1" Padding="12,8">
                        <TextBlock Text="QOLDIQ" FontWeight="SemiBold" Foreground="#111827"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="2" BorderBrush="#D5DDE8" BorderThickness="0,0,1,1" Padding="12,8">
                        <TextBlock Text="NARX" FontWeight="SemiBold" Foreground="#111827"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="3" BorderBrush="#D5DDE8" BorderThickness="0,0,1,1" Padding="12,8">
                        <TextBlock Text="BIRLIK" FontWeight="SemiBold" Foreground="#111827"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="4" BorderBrush="#D5DDE8" BorderThickness="0,0,0,1" Padding="12,8">
                        <TextBlock Text="SHTRIX-KOD" FontWeight="SemiBold" Foreground="#111827"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Products list -->
                <ListView x:Name="ProductsList"
                          Grid.Row="3"
                          ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                          SelectionMode="Single"
                          FontSize="14"
                          BorderThickness="0"
                          Padding="0"
                          Background="Transparent"
                          ScrollViewer.CanContentScroll="False"
                          VirtualizingPanel.IsVirtualizing="False"
                          ItemContainerStyle="{StaticResource TableRowStyle}"
                          SelectionChanged="ListView_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="42" Width="{Binding ActualWidth, ElementName=ProductsList}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1.5*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" BorderBrush="#DCE3EC" BorderThickness="0,0,1,0" Padding="12,8">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Border>
                                <Border Grid.Column="1" BorderBrush="#DCE3EC" BorderThickness="0,0,1,0" Padding="12,8">
                                    <TextBlock VerticalAlignment="Center"
                                               HorizontalAlignment="Center" TextAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Quantity, StringFormat={}{0:0.##}}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.InventoryEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                 Value="False">
                                                        <Setter Property="Text" Value="—" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Border Grid.Column="2" BorderBrush="#DCE3EC" BorderThickness="0,0,1,0" Padding="12,8">
                                    <TextBlock Text="{Binding Price, StringFormat={}{0:N0}}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center" TextAlignment="Center" />
                                </Border>
                                <Border Grid.Column="3" BorderBrush="#DCE3EC" BorderThickness="0,0,1,0" Padding="12,8">
                                    <TextBlock Text="{Binding Unit}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center" TextAlignment="Center" />
                                </Border>
                                <Border Grid.Column="4" Padding="12,8">
                                    <TextBlock Text="{Binding Barcode}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center" TextAlignment="Center" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>



            </Grid>

        </Border>


        <!-- ====================================================== -->
        <!-- RIGHT: PRODUCT FORM                                   -->
        <!-- ====================================================== -->

        <Border Grid.Column="1"
                Style="{StaticResource CardStyle}"
                Background="#E2E8F0"
                BorderThickness="0,1,1,1">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Form header -->

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,16">

                    <TextBlock Text="{Binding FormTitle}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryText}"/>

                    <TextBlock Text="{Binding FormDescription}"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryText}"
                               Margin="0,4,0,0"/>

                </StackPanel>


                <!-- Form -->

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <!-- Name -->

                        <TextBlock Text="Mahsulot nomi"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding IsCreating}"
                                    FontSize="15"
                                    MinHeight="44"
                                    Margin="0,0,0,14"/>


                        <!-- Price -->

                        <TextBlock Text="Narx (so'm)"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <ui:TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                                    FontSize="15"
                                    MinHeight="44"
                                    Margin="0,0,0,14"/>

                        <TextBlock Text="Qoldiq miqdori"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Visibility="{Binding InventoryEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <ui:TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                    FontSize="15"
                                    MinHeight="44"
                                    Margin="0,0,0,14"
                                    Visibility="{Binding InventoryEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>


                        <!-- Unit -->

                        <TextBlock Text="Birlik"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <ComboBox ItemsSource="{Binding Units}"
                                  SelectedItem="{Binding SelectedUnit}"
                                  IsEnabled="{Binding IsCreating}"
                                  FontSize="15"
                                  MinHeight="44"
                                  Margin="0,0,0,14"
                                  HorizontalAlignment="Stretch"/>

                        <TextBlock Text="Kategoriya"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  IsEnabled="{Binding IsCreating}"
                                  DisplayMemberPath="Name"
                                  MinHeight="44"
                                  FontSize="15"
                                  Margin="0,0,0,14"/>

                        <!-- Barcode -->

                        <TextBlock Text="Shtrix-kod"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <ui:TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding IsCreating}"
                                    PlaceholderText="Ixtiyoriy"
                                    FontSize="15"
                                    MinHeight="44"
                                    Margin="0,0,0,16"/>


                        <!-- Error -->

                        <Border Background="#FEF2F2"
                                BorderBrush="#FECACA"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,0,0,16">

                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{StaticResource DangerText}"
                                       TextWrapping="Wrap"
                                       FontSize="13"/>

                        </Border>


                        <StackPanel Orientation="Vertical"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,8,0,0">

                            <!-- Save -->
                            <ui:Button Content="Saqlash"
                                       Command="{Binding SaveCommand}"
                                       Appearance="Primary"
                                       MinHeight="46"
                                       HorizontalAlignment="Stretch"
                                       Margin="0,0,0,8"/>

                            <!-- New product -->
                            <ui:Button Content="Yangi mahsulot"
                                       Command="{Binding NewProductCommand}"
                                       MinHeight="44"
                                       HorizontalAlignment="Stretch"
                                       Margin="0,0,0,8"/>

                            <!-- Deactivate -->
                            <ui:Button Content="Ro'yxatdan olib tashlash"
                                       Command="{Binding DeactivateCommand}"
                                       MinHeight="44"
                                       HorizontalAlignment="Stretch"
                                       Margin="0,0,0,8"/>

                        </StackPanel>

                    </StackPanel>

                </ScrollViewer>

            </Grid>

        </Border>

    </Grid>

</UserControl>
