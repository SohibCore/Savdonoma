<Window x:Class="Savdonoma.Views.ReceiptPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Savdonoma.Converters"
        Title="Chek ko‘rinishi" Width="560" Height="780"
        MinWidth="460" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#EEF2F8" Language="uz-Latn-UZ">
    <Window.Resources>
        <conv:MoneyConverter x:Key="Money" />

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Chek ko‘rinishi" FontSize="22" FontWeight="SemiBold"
                       Foreground="#172554" />
            <TextBlock Text="Savdo chekini ko‘rish yoki printerga yuborish"
                       FontSize="13" Foreground="#71809B" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,14"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Width="360" HorizontalAlignment="Center"
                    Background="#FFFEFA" BorderBrush="#E1E5EC"
                    BorderThickness="1" CornerRadius="4"
                    Padding="25,24">
                <Border.Effect>
                    <DropShadowEffect Color="#56627A" BlurRadius="18"
                                      ShadowDepth="4" Opacity="0.16" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding ShopName}" FontSize="17"
                               FontWeight="Bold" Foreground="#111827"
                               TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Address}" FontSize="12"
                               Foreground="#374151" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,3,0,10" />

                    <TextBlock Text="------------------------------------------"
                               FontFamily="Consolas" FontSize="10"
                               Foreground="#8B929E" TextAlignment="Center" />

                    <TextBlock Margin="0,8,0,2" FontSize="12" Foreground="#222">
                        <Run Text="Kassir: " />
                        <Run Text="{Binding Cashier}" />
                    </TextBlock>
                    <TextBlock Margin="0,2" FontSize="12" Foreground="#222">
                        <Run Text="Sana: " />
                        <Run Text="{Binding Date, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" />
                    </TextBlock>
                    <TextBlock Margin="0,2" FontSize="12" Foreground="#222">
                        <Run Text="Stir: " />
                        <Run Text="{Binding INN}" />
                    </TextBlock>
                    <TextBlock Margin="0,2,0,7" FontSize="12" FontWeight="SemiBold"
                               Foreground="#222">
                        <Run Text="#" />
                        <Run Text="{Binding ReceiptNumber}" />
                    </TextBlock>

                    <TextBlock Text="------------------------------------------"
                               FontFamily="Consolas" FontSize="10"
                               Foreground="#8B929E" TextAlignment="Center" />

                    <ItemsControl ItemsSource="{Binding Items}" Margin="0,6,0,7">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,5,0,4">
                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                               FontWeight="SemiBold" Foreground="#111827"
                                               TextWrapping="Wrap" />
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Quantity, StringFormat={}{0:0.###}}"
                                                   FontFamily="Consolas" FontSize="11" />
                                        <TextBlock Grid.Column="1" Text="×"
                                                   Margin="4,0" FontSize="11" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Price, StringFormat={}{0:N2}}"
                                                   FontFamily="Consolas" FontSize="11"
                                                   TextAlignment="Right" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding LineTotal, StringFormat={}{0:N2}}"
                                                   FontFamily="Consolas" FontSize="11"
                                                   TextAlignment="Right" Margin="8,0,0,0" />
                                    </Grid>
                                    <TextBlock Text="{Binding VatAmount, StringFormat={}shu jumladan QQS 12% {0:N2}}"
                                               FontSize="10" Foreground="#4B5563"
                                               TextAlignment="Right" />
                                    <TextBlock Text="{Binding UnitDisplay}" FontSize="10"
                                               Foreground="#5B6472" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding MxikDisplay}" FontSize="10"
                                               Foreground="#5B6472" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding BarcodeDisplay}" FontSize="10"
                                               Foreground="#5B6472" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="------------------------------------------"
                               FontFamily="Consolas" FontSize="10"
                               Foreground="#8B929E" TextAlignment="Center" />

                    <Grid Margin="0,8,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="JAMI:" FontSize="17" FontWeight="Bold"
                                   Foreground="#111827" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Total, StringFormat={}{0:N2}}"
                                   FontFamily="Consolas" FontSize="17"
                                   FontWeight="Bold" Foreground="#111827" />
                    </Grid>

                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Jami QQS" FontSize="11" Foreground="#374151" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TotalVat, StringFormat={}{0:N2}}"
                                   FontFamily="Consolas" FontSize="11" Foreground="#374151" />
                    </Grid>

                    <TextBlock Text="------------------------------------------"
                               FontFamily="Consolas" FontSize="10"
                               Foreground="#8B929E" TextAlignment="Center"
                               Margin="0,3,0,0" />

                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="NAQD:" FontSize="11" Foreground="#374151" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Cash, StringFormat={}{0:N2}}"
                                   FontFamily="Consolas" FontSize="11" Foreground="#374151" />
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="BANK KARTA:" FontSize="11" Foreground="#374151" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Card, StringFormat={}{0:N2}}"
                                   FontFamily="Consolas" FontSize="11" Foreground="#374151" />
                    </Grid>

                    <TextBlock Text="------------------------------------------"
                               FontFamily="Consolas" FontSize="10"
                               Foreground="#8B929E" TextAlignment="Center"
                               Margin="0,3,0,0" />

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="JAMI:" FontSize="12" FontWeight="Bold"
                                   Foreground="#111827" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Total, StringFormat={}{0:N2}}"
                                   FontFamily="Consolas" FontSize="12"
                                   FontWeight="Bold" Foreground="#111827" />
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <TextBlock x:Name="PrintStatus" Grid.Row="2" Foreground="#475569"
                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Yopish" IsCancel="True"
                    Style="{StaticResource ActionButtonStyle}"
                    Background="#E2E8F0" Foreground="#1E293B"
                    Margin="0,0,8,0" />
            <Button x:Name="PrintButton" Content="Chop etish"
                    Click="PrintButton_Click"
                    Style="{StaticResource ActionButtonStyle}"
                    Background="#2563EB" Foreground="White" />
        </StackPanel>
    </Grid>
</Window>
