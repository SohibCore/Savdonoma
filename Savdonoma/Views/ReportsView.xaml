<UserControl x:Class="Savdonoma.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:Savdonoma.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1200">

    <UserControl.Resources>

        <conv:MoneyConverter x:Key="Money" />
        <SolidColorBrush x:Key="ReportCardBackground"
                         Color="#FFFFFF" />

        <SolidColorBrush x:Key="ReportBorderBrush"
                         Color="#E5E7EB" />

        <SolidColorBrush x:Key="ReportPrimaryText"
                         Color="#111827" />

        <SolidColorBrush x:Key="ReportSecondaryText"
                         Color="#6B7280" />

        <SolidColorBrush x:Key="ReportSuccessBackground"
                         Color="#ECFDF3" />

        <SolidColorBrush x:Key="ReportSuccessText"
                         Color="#15803D" />

        <SolidColorBrush x:Key="ReportDangerBackground"
                         Color="#FEF2F2" />

        <SolidColorBrush x:Key="ReportDangerText"
                         Color="#DC2626" />

        <Style x:Key="ReportColumnCell"
               TargetType="Border">
            <Setter Property="BorderBrush"
                    Value="#DCE3EC" />
            <Setter Property="BorderThickness"
                    Value="0,0,1,1" />
            <Setter Property="Padding"
                    Value="12,8" />
        </Style>

        <Style x:Key="ReportDetailHeaderCell"
               TargetType="Border"
               BasedOn="{StaticResource ReportColumnCell}">
            <Setter Property="Background"
                    Value="#E9EEF5" />
            <Setter Property="BorderBrush"
                    Value="#D5DDE8" />
        </Style>

        <Style x:Key="ReportDetailsPanelStyle"
               TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="MaxHeight" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="MaxHeight" Value="9999" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1"
                                                 Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="0"
                                                 Duration="0:0:0.1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReportSaleRowItemStyle"
               TargetType="ListViewItem"
               BasedOn="{StaticResource TableRowStyle}">
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Background"
                    Value="White" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"
                            Value="#F0F4FF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background"
                            Value="#EEF3FF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReportCard"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#E2E8F0" />

            <Setter Property="BorderBrush"
                    Value="{StaticResource ReportBorderBrush}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="CornerRadius"
                    Value="10" />

            <Setter Property="Padding"
                    Value="18" />

        </Style>

        <Style x:Key="ReportCardLabel"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13" />

            <Setter Property="Foreground"
                    Value="{StaticResource ReportSecondaryText}" />

            <Setter Property="FontWeight"
                    Value="Medium" />

        </Style>

        <Style x:Key="ReportCardValue"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="24" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Foreground"
                    Value="{StaticResource ReportPrimaryText}" />

        </Style>

        <Style x:Key="CancelledAwareText"
               TargetType="TextBlock">

            <Setter Property="VerticalAlignment"
                    Value="Center" />

            <Setter Property="Foreground"
                    Value="{StaticResource ReportPrimaryText}" />

            <Setter Property="FontSize"
                    Value="14" />

            <Style.Triggers>

                <DataTrigger Binding="{Binding Status}"
                             Value="Cancelled">

                    <Setter Property="Foreground"
                            Value="#9CA3AF" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>


    <!-- UserControl ning YAGONA Content'i -->
    <Grid Background="Transparent"
          Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />

            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>


        <!-- =========================
             HEADER
             ========================= -->

        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*" />

                <ColumnDefinition Width="Auto" />

            </Grid.ColumnDefinitions>


            <!-- Title -->

            <StackPanel Grid.Column="0">

                <TextBlock Text="Hisobotlar"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ReportPrimaryText}" 
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Savdo natijalari va cheklar statistikasi"
                           FontSize="13"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource ReportSecondaryText}" 
                           HorizontalAlignment="Center"/>

            </StackPanel>


            <!-- Filters -->

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">


                <Border Background="{StaticResource ReportCardBackground}"
                        BorderBrush="{StaticResource ReportBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,2"
                        Margin="0,0,8,0">

                    <DatePicker SelectedDate="{Binding FromDate}"
                                SelectedDateFormat="Short"
                                Width="125"
                                Height="34"
                                BorderThickness="0" />

                </Border>


                <TextBlock Text="—"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="{StaticResource ReportSecondaryText}" />


                <Border Background="{StaticResource ReportCardBackground}"
                        BorderBrush="{StaticResource ReportBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,2"
                        Margin="0,0,12,0">

                    <DatePicker SelectedDate="{Binding ToDate}"
                                SelectedDateFormat="Short"
                                Width="125"
                                Height="34"
                                BorderThickness="0" />

                </Border>


                <ui:Button Content="Bugun"
                           Command="{Binding ShowTodayCommand}"
                           MinHeight="38"
                           Margin="0,0,6,0" />

                <ui:Button Content="Hafta"
                           Command="{Binding ShowWeekCommand}"
                           MinHeight="38"
                           Margin="0,0,6,0" />

                <ui:Button Content="Oy"
                           Command="{Binding ShowMonthCommand}"
                           MinHeight="38"
                           Margin="0,0,10,0" />

                <ui:Button Content="↻ Yangilash"
                           Command="{Binding RefreshCommand}"
                           MinHeight="38" />

            </StackPanel>

        </Grid>


        <!-- =========================
             KPI CARDS
             ========================= -->

        <Grid Grid.Row="1"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="2*" />

                <ColumnDefinition Width="*" />

                <ColumnDefinition Width="*" />

                <ColumnDefinition Width="*" />

                <ColumnDefinition Width="*" />

            </Grid.ColumnDefinitions>


            <!-- Jami -->

            <Border Grid.Column="0"
                    Style="{StaticResource ReportCard}"
                    Margin="0,0,10,0">

                <StackPanel>

                    <TextBlock Text="JAMI SAVDO"
                               Style="{StaticResource ReportCardLabel}" />

                    <TextBlock Text="{Binding TotalAmount, Converter={StaticResource Money}}"
                               Style="{StaticResource ReportCardValue}"
                               Margin="0,8,0,0" />

                    <TextBlock Text="so'm"
                               FontSize="12"
                               Foreground="{StaticResource ReportSecondaryText}"
                               Margin="0,2,0,0" />

                </StackPanel>

            </Border>


            <!-- Cheklar -->

            <Border Grid.Column="1"
                    Style="{StaticResource ReportCard}"
                    Margin="0,0,10,0">

                <StackPanel>

                    <TextBlock Text="CHEKLAR"
                               Style="{StaticResource ReportCardLabel}" />

                    <TextBlock Text="{Binding SalesCount}"
                               Style="{StaticResource ReportCardValue}"
                               Margin="0,8,0,0" />

                    <TextBlock FontSize="12"
                               Foreground="{StaticResource ReportSecondaryText}"
                               Margin="0,3,0,0">

                        <Run Text="Bekor: " />

                        <Run Text="{Binding CancelledCount}" />

                    </TextBlock>

                </StackPanel>

            </Border>


            <!-- Naqd -->

            <Border Grid.Column="2"
                    Style="{StaticResource ReportCard}"
                    Margin="0,0,10,0">

                <StackPanel>

                    <TextBlock Text="NAQD"
                               Style="{StaticResource ReportCardLabel}" />

                    <TextBlock Text="{Binding CashAmount, Converter={StaticResource Money}}"
                               Style="{StaticResource ReportCardValue}"
                               Margin="0,8,0,0" />

                    <TextBlock Text="so'm"
                               FontSize="12"
                               Foreground="{StaticResource ReportSecondaryText}"
                               Margin="0,2,0,0" />

                </StackPanel>

            </Border>


            <!-- Karta -->

            <Border Grid.Column="3"
                    Style="{StaticResource ReportCard}"
                    Margin="0,0,10,0">

                <StackPanel>

                    <TextBlock Text="KARTA"
                               Style="{StaticResource ReportCardLabel}" />

                    <TextBlock Text="{Binding CardAmount, Converter={StaticResource Money}}"
                               Style="{StaticResource ReportCardValue}"
                               Margin="0,8,0,0" />

                    <TextBlock Text="so'm"
                               FontSize="12"
                               Foreground="{StaticResource ReportSecondaryText}"
                               Margin="0,2,0,0" />

                </StackPanel>

            </Border>


            <!-- O'rtacha -->

            <Border Grid.Column="4"
                    Style="{StaticResource ReportCard}">

                <StackPanel>

                    <TextBlock Text="O'RTACHA CHEK"
                               Style="{StaticResource ReportCardLabel}" />

                    <TextBlock Text="{Binding AverageCheck, Converter={StaticResource Money}}"
                               Style="{StaticResource ReportCardValue}"
                               Margin="0,8,0,0" />

                    <TextBlock Text="so'm"
                               FontSize="12"
                               Foreground="{StaticResource ReportSecondaryText}"
                               Margin="0,2,0,0" />

                </StackPanel>

            </Border>

        </Grid>


        <!-- =========================
             SALES
             ========================= -->

        <Border Grid.Row="2"
                Style="{StaticResource ReportCard}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>


                <!-- Sales header -->

                <Grid Grid.Row="0"
                      Margin="0,0,0,16">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="Auto" />

                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Cheklar"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ReportPrimaryText}" 
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Tanlangan sana oralig'idagi savdolar"
                                   FontSize="12"
                                   Margin="0,3,0,0"
                                   Foreground="{StaticResource ReportSecondaryText}" 
                                   HorizontalAlignment="Center"/>

                    </StackPanel>


                    <ui:Button Grid.Column="1"
                               Content="Bekor qilish"
                               Command="{Binding CancelSaleCommand}"
                               MinHeight="40"
                               Padding="18,0" />

                </Grid>


                <Grid Grid.Row="1" MinHeight="42" Background="#E9EEF5"
                      Width="{Binding ActualWidth, ElementName=SalesList}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="0.7*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="38" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource ReportDetailHeaderCell}">
                        <TextBlock Text="CHEK RAQAMI" FontWeight="SemiBold"
                                   Foreground="{StaticResource ReportPrimaryText}" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource ReportDetailHeaderCell}">
                        <TextBlock Text="SANA VA VAQT" FontWeight="SemiBold"
                                   Foreground="{StaticResource ReportPrimaryText}" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource ReportDetailHeaderCell}">
                        <TextBlock Text="TO'LOV" FontWeight="SemiBold"
                                   Foreground="{StaticResource ReportPrimaryText}" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource ReportDetailHeaderCell}">
                        <TextBlock Text="SUMMA" FontWeight="SemiBold"
                                   Foreground="{StaticResource ReportPrimaryText}" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource ReportDetailHeaderCell}">
                        <TextBlock Text="HOLAT" FontWeight="SemiBold"
                                   Foreground="{StaticResource ReportPrimaryText}" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="5" Style="{StaticResource ReportDetailHeaderCell}" />
                </Grid>

                <ListView x:Name="SalesList" Grid.Row="2"
                          ItemsSource="{Binding Sales}"
                          SelectedItem="{Binding SelectedSale, Mode=TwoWay}"
                          SelectionMode="Single"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          FontSize="14"
                          ScrollViewer.CanContentScroll="False"
                          VirtualizingPanel.IsVirtualizing="False"
                          PreviewMouseLeftButtonDown="SalesList_PreviewMouseLeftButtonDown"
                          ItemContainerStyle="{StaticResource ReportSaleRowItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <!-- Row header — bitta click bilan ochiladi -->
                                <Grid MinHeight="44" HorizontalAlignment="Stretch"
                                      Width="{Binding ActualWidth, ElementName=SalesList}"
                                      Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="0.7*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="38" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource ReportColumnCell}">
                                        <TextBlock Text="{Binding Number}"
                                                   Style="{StaticResource CancelledAwareText}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource ReportColumnCell}">
                                        <TextBlock Text="{Binding Time, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                                   Style="{StaticResource CancelledAwareText}"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource ReportColumnCell}">
                                        <TextBlock Text="{Binding PaymentMethod}"
                                                   Style="{StaticResource CancelledAwareText}"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource ReportColumnCell}">
                                        <TextBlock Text="{Binding TotalAmount, Converter={StaticResource Money}}"
                                                   Style="{StaticResource CancelledAwareText}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Column="4" Style="{StaticResource ReportColumnCell}">
                                        <Border CornerRadius="14" Padding="9,4"
                                                HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E7F8F0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                            <Setter Property="Background" Value="#FEF2F2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="16" Height="16"
                                                        CornerRadius="8"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#10A37F" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                                    <Setter Property="Background" Value="#DC2626" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="✓" Foreground="White"
                                                               FontSize="10" FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="✓" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                                        <Setter Property="Text" Value="!" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding StatusDisplay}" FontSize="12"
                                                           VerticalAlignment="Center" Margin="7,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#07815F" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                                    <Setter Property="Foreground" Value="#B91C1C" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                    <!-- Chevron icon -->
                                    <Border Grid.Column="5" Style="{StaticResource ReportColumnCell}"
                                            HorizontalAlignment="Stretch">
                                        <TextBlock Text="⌄" FontSize="18"
                                                   Foreground="{StaticResource ReportSecondaryText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform x:Name="ChevronRotate" Angle="0" />
                                            </TextBlock.RenderTransform>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation
                                                                            Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                                                            To="180" Duration="0:0:0.2">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation
                                                                            Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                                                            To="0" Duration="0:0:0.2">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                                <Border Background="#F8FAFC" BorderBrush="{StaticResource ReportBorderBrush}"
                                        BorderThickness="0,1,0,0" Padding="12"
                                        Style="{StaticResource ReportDetailsPanelStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="1.2*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource ReportColumnCell}">
                                                <TextBlock Text="Mahsulot" FontWeight="SemiBold"
                                                           Foreground="{StaticResource ReportSecondaryText}" />
                                            </Border>
                                            <Border Grid.Column="1" Style="{StaticResource ReportColumnCell}">
                                                <TextBlock Text="Narx" FontWeight="SemiBold"
                                                           Foreground="{StaticResource ReportSecondaryText}"
                                                           TextAlignment="Right" />
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource ReportColumnCell}">
                                                <TextBlock Text="Miqdor" FontWeight="SemiBold"
                                                           Foreground="{StaticResource ReportSecondaryText}"
                                                           TextAlignment="Right" />
                                            </Border>
                                            <Border Grid.Column="3" Style="{StaticResource ReportColumnCell}">
                                                <TextBlock Text="Summa" FontWeight="SemiBold"
                                                           Foreground="{StaticResource ReportSecondaryText}"
                                                           TextAlignment="Right" />
                                            </Border>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Detail.Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid MinHeight="36">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="3*" />
                                                            <ColumnDefinition Width="1.2*" />
                                                            <ColumnDefinition Width="1.2*" />
                                                            <ColumnDefinition Width="1.2*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Style="{StaticResource ReportColumnCell}">
                                                            <TextBlock Text="{Binding ProductName}" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Border Grid.Column="1" Style="{StaticResource ReportColumnCell}">
                                                            <TextBlock Text="{Binding UnitPrice, Converter={StaticResource Money}}"
                                                                       VerticalAlignment="Center" TextAlignment="Right" />
                                                        </Border>
                                                        <Border Grid.Column="2" Style="{StaticResource ReportColumnCell}">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                <TextBlock Text="{Binding Quantity, StringFormat={}{0:0.###}}" />
                                                                <TextBlock Text="{Binding Unit}" Margin="4,0,0,0" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Grid.Column="3" Style="{StaticResource ReportColumnCell}">
                                                            <TextBlock Text="{Binding LineTotal, Converter={StaticResource Money}}"
                                                                       VerticalAlignment="Center" TextAlignment="Right"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <UniformGrid Columns="5" Margin="0,10,0,0">
                                            <Border Background="#F1F5F9" BorderBrush="{StaticResource ReportBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <TextBlock Text="Jami" Style="{StaticResource ReportCardLabel}" />
                                                    <TextBlock Text="{Binding Detail.TotalAmount, Converter={StaticResource Money}}"
                                                               FontSize="20" FontWeight="SemiBold"
                                                               Foreground="{StaticResource ReportPrimaryText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#F1F5F9" BorderBrush="{StaticResource ReportBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8" Padding="12" Margin="4,0">
                                                <StackPanel>
                                                    <TextBlock Text="Mijozdan olingan"
                                                               Style="{StaticResource ReportCardLabel}" />
                                                    <TextBlock Text="{Binding Detail.ReceivedAmount, Converter={StaticResource Money}}"
                                                               FontSize="20" FontWeight="SemiBold"
                                                               Foreground="{StaticResource ReportPrimaryText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#F1F5F9" BorderBrush="{StaticResource ReportBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8" Padding="12" Margin="8,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="Qaytim" Style="{StaticResource ReportCardLabel}" />
                                                    <TextBlock Text="{Binding Detail.ChangeAmount, Converter={StaticResource Money}}"
                                                               FontSize="20" FontWeight="SemiBold"
                                                               Foreground="{StaticResource ReportSuccessText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#F1F5F9" BorderBrush="{StaticResource ReportBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8" Padding="12" Margin="4,0">
                                                <StackPanel>
                                                    <TextBlock Text="To'lov turi" Style="{StaticResource ReportCardLabel}" />
                                                    <TextBlock Text="{Binding Detail.PaymentMethod}"
                                                               FontSize="18" FontWeight="SemiBold"
                                                               Foreground="{StaticResource ReportPrimaryText}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#F1F5F9" BorderBrush="{StaticResource ReportBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8" Padding="12" Margin="8,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="Sotuvchi" Style="{StaticResource ReportCardLabel}" />
                                                    <TextBlock Text="{Binding Detail.SellerName}"
                                                               FontSize="18" FontWeight="SemiBold"
                                                               Foreground="{StaticResource ReportPrimaryText}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                        <TextBlock Text="Sotuv ma'lumotlari yuklanmoqda..."
                                                   Foreground="{StaticResource ReportSecondaryText}"
                                                   Margin="0,8,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLoadingDetail}"
                                                                     Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding DetailError}"
                                                   Foreground="{StaticResource ReportDangerText}"
                                                   TextWrapping="Wrap" Margin="0,8,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DetailError}"
                                                                     Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DetailError}"
                                                                     Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </Grid>

        </Border>


        <!-- =========================
             ERROR
             ========================= -->

        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Foreground="#DC2626"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />

    </Grid>

</UserControl>