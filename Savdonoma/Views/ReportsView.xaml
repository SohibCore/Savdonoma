<UserControl x:Class="Savdonoma.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:Savdonoma.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1200">

    <UserControl.Resources>

        <conv:MoneyConverter x:Key="Money" />

        <SolidColorBrush x:Key="ReportCardBackground"
                         Color="#FFFFFF" />

        <SolidColorBrush x:Key="ReportBorderBrush"
                         Color="#E5E7EB" />

        <SolidColorBrush x:Key="ReportPrimaryText"
                         Color="#111827" />

        <SolidColorBrush x:Key="ReportSecondaryText"
                         Color="#6B7280" />

        <SolidColorBrush x:Key="ReportSuccessBackground"
                         Color="#ECFDF3" />

        <SolidColorBrush x:Key="ReportSuccessText"
                         Color="#15803D" />

        <SolidColorBrush x:Key="ReportDangerBackground"
                         Color="#FEF2F2" />

        <SolidColorBrush x:Key="ReportDangerText"
                         Color="#DC2626" />

        <Style x:Key="ReportCard"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{StaticResource ReportCardBackground}" />

            <Setter Property="BorderBrush"
                    Value="{StaticResource ReportBorderBrush}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="CornerRadius"
                    Value="10" />

            <Setter Property="Padding"
                    Value="18" />

        </Style>

        <Style x:Key="ReportCardLabel"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13" />

            <Setter Property="Foreground"
                    Value="{StaticResource ReportSecondaryText}" />

            <Setter Property="FontWeight"
                    Value="Medium" />

        </Style>

        <Style x:Key="ReportCardValue"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="24" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Foreground"
                    Value="{StaticResource ReportPrimaryText}" />

        </Style>

        <Style x:Key="CancelledAwareText"
               TargetType="TextBlock">

            <Setter Property="VerticalAlignment"
                    Value="Center" />

            <Setter Property="Foreground"
                    Value="{StaticResource ReportPrimaryText}" />

            <Setter Property="FontSize"
                    Value="14" />

            <Style.Triggers>

                <DataTrigger Binding="{Binding Status}"
                             Value="Cancelled">

                    <Setter Property="Foreground"
                            Value="#9CA3AF" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>


    <!-- UserControl ning YAGONA Content'i -->
    <Grid Background="Transparent"
          Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />

            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>


        <!-- =========================
             HEADER
             ========================= -->

        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*" />

                <ColumnDefinition Width="Auto" />

            </Grid.ColumnDefinitions>


            <!-- Title -->

            <StackPanel Grid.Column="0">

                <TextBlock Text="Hisobotlar"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ReportPrimaryText}" 
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Savdo natijalari va cheklar statistikasi"
                           FontSize="13"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource ReportSecondaryText}" 
                           HorizontalAlignment="Center"/>

            </StackPanel>


            <!-- Filters -->

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">


                <Border Background="{StaticResource ReportCardBackground}"
                        BorderBrush="{StaticResource ReportBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,2"
                        Margin="0,0,8,0">

                    <DatePicker SelectedDate="{Binding FromDate}"
                                SelectedDateFormat="Short"
                                Width="125"
                                Height="34"
                                BorderThickness="0" />

                </Border>


                <TextBlock Text="—"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="{StaticResource ReportSecondaryText}" />


                <Border Background="{StaticResource ReportCardBackground}"
                        BorderBrush="{StaticResource ReportBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,2"
                        Margin="0,0,12,0">

                    <DatePicker SelectedDate="{Binding ToDate}"
                                SelectedDateFormat="Short"
                                Width="125"
                                Height="34"
                                BorderThickness="0" />

                </Border>


                <ui:Button Content="Bugun"
                           Command="{Binding ShowTodayCommand}"
                           MinHeight="38"
                           Margin="0,0,6,0" />

                <ui:Button Content="Hafta"
                           Command="{Binding ShowWeekCommand}"
                           MinHeight="38"
                           Margin="0,0,6,0" />

                <ui:Button Content="Oy"
                           Command="{Binding ShowMonthCommand}"
                           MinHeight="38"
                           Margin="0,0,10,0" />

                <ui:Button Content="↻ Yangilash"
                           Command="{Binding RefreshCommand}"
                           MinHeight="38" />

            </StackPanel>

        </Grid>


        <!-- =========================
             KPI CARDS
             ========================= -->

        <Grid Grid.Row="1"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="2*" />

                <ColumnDefinition Width="*" />

                <ColumnDefinition Width="*" />

                <ColumnDefinition Width="*" />

                <ColumnDefinition Width="*" />

            </Grid.ColumnDefinitions>


            <!-- Jami -->

            <Border Grid.Column="0"
                    Style="{StaticResource ReportCard}"
                    Margin="0,0,10,0">

                <StackPanel>

                    <TextBlock Text="JAMI SAVDO"
                               Style="{StaticResource ReportCardLabel}" />

                    <TextBlock Text="{Binding TotalAmount, Converter={StaticResource Money}}"
                               Style="{StaticResource ReportCardValue}"
                               Margin="0,8,0,0" />

                    <TextBlock Text="so'm"
                               FontSize="12"
                               Foreground="{StaticResource ReportSecondaryText}"
                               Margin="0,2,0,0" />

                </StackPanel>

            </Border>


            <!-- Cheklar -->

            <Border Grid.Column="1"
                    Style="{StaticResource ReportCard}"
                    Margin="0,0,10,0">

                <StackPanel>

                    <TextBlock Text="CHEKLAR"
                               Style="{StaticResource ReportCardLabel}" />

                    <TextBlock Text="{Binding SalesCount}"
                               Style="{StaticResource ReportCardValue}"
                               Margin="0,8,0,0" />

                    <TextBlock FontSize="12"
                               Foreground="{StaticResource ReportSecondaryText}"
                               Margin="0,3,0,0">

                        <Run Text="Bekor: " />

                        <Run Text="{Binding CancelledCount}" />

                    </TextBlock>

                </StackPanel>

            </Border>


            <!-- Naqd -->

            <Border Grid.Column="2"
                    Style="{StaticResource ReportCard}"
                    Margin="0,0,10,0">

                <StackPanel>

                    <TextBlock Text="NAQD"
                               Style="{StaticResource ReportCardLabel}" />

                    <TextBlock Text="{Binding CashAmount, Converter={StaticResource Money}}"
                               Style="{StaticResource ReportCardValue}"
                               Margin="0,8,0,0" />

                    <TextBlock Text="so'm"
                               FontSize="12"
                               Foreground="{StaticResource ReportSecondaryText}"
                               Margin="0,2,0,0" />

                </StackPanel>

            </Border>


            <!-- Karta -->

            <Border Grid.Column="3"
                    Style="{StaticResource ReportCard}"
                    Margin="0,0,10,0">

                <StackPanel>

                    <TextBlock Text="KARTA"
                               Style="{StaticResource ReportCardLabel}" />

                    <TextBlock Text="{Binding CardAmount, Converter={StaticResource Money}}"
                               Style="{StaticResource ReportCardValue}"
                               Margin="0,8,0,0" />

                    <TextBlock Text="so'm"
                               FontSize="12"
                               Foreground="{StaticResource ReportSecondaryText}"
                               Margin="0,2,0,0" />

                </StackPanel>

            </Border>


            <!-- O'rtacha -->

            <Border Grid.Column="4"
                    Style="{StaticResource ReportCard}">

                <StackPanel>

                    <TextBlock Text="O'RTACHA CHEK"
                               Style="{StaticResource ReportCardLabel}" />

                    <TextBlock Text="{Binding AverageCheck, Converter={StaticResource Money}}"
                               Style="{StaticResource ReportCardValue}"
                               Margin="0,8,0,0" />

                    <TextBlock Text="so'm"
                               FontSize="12"
                               Foreground="{StaticResource ReportSecondaryText}"
                               Margin="0,2,0,0" />

                </StackPanel>

            </Border>

        </Grid>


        <!-- =========================
             SALES
             ========================= -->

        <Border Grid.Row="2"
                Style="{StaticResource ReportCard}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>


                <!-- Sales header -->

                <Grid Grid.Row="0"
                      Margin="0,0,0,16">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="Auto" />

                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Cheklar"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ReportPrimaryText}" 
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Tanlangan sana oralig'idagi savdolar"
                                   FontSize="12"
                                   Margin="0,3,0,0"
                                   Foreground="{StaticResource ReportSecondaryText}" 
                                   HorizontalAlignment="Center"/>

                    </StackPanel>


                    <ui:Button Grid.Column="1"
                               Content="Bekor qilish"
                               Command="{Binding CancelSaleCommand}"
                               MinHeight="40"
                               Padding="18,0" />

                </Grid>


                <Grid Grid.Row="1" MinHeight="42" Background="#F8FAFC">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="0.7*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="0.8*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CHEK RAQAMI" FontWeight="SemiBold"
                               Foreground="{StaticResource ReportPrimaryText}" VerticalAlignment="Center"
                               Padding="8,8" />
                    <TextBlock Grid.Column="1" Text="SANA VA VAQT" FontWeight="SemiBold"
                               Foreground="{StaticResource ReportPrimaryText}" VerticalAlignment="Center"
                               Padding="8,8" />
                    <TextBlock Grid.Column="2" Text="TO'LOV" FontWeight="SemiBold"
                               Foreground="{StaticResource ReportPrimaryText}" VerticalAlignment="Center"
                               Padding="8,8" />
                    <TextBlock Grid.Column="3" Text="SUMMA" FontWeight="SemiBold"
                               Foreground="{StaticResource ReportPrimaryText}" VerticalAlignment="Center"
                               Padding="8,8" />
                    <TextBlock Grid.Column="4" Text="HOLAT" FontWeight="SemiBold"
                               Foreground="{StaticResource ReportPrimaryText}" VerticalAlignment="Center"
                               Padding="8,8" />
                </Grid>

                <ListView Grid.Row="2"
                          ItemsSource="{Binding Sales}"
                          SelectedItem="{Binding SelectedSale, Mode=TwoWay}"
                          SelectionMode="Single"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          FontSize="14">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource TableRowStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch">
                                <Expander.Header>
                                    <Grid MinHeight="44" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="0.7*" />
                                            <ColumnDefinition Width="0.8*" />
                                            <ColumnDefinition Width="0.8*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Number}"
                                                   Style="{StaticResource CancelledAwareText}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Padding="8,8" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Time, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                                   Style="{StaticResource CancelledAwareText}"
                                                   VerticalAlignment="Center" Padding="8,8" />
                                        <TextBlock Grid.Column="2" Text="{Binding PaymentMethod}"
                                                   Style="{StaticResource CancelledAwareText}"
                                                   VerticalAlignment="Center" Padding="8,8" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding TotalAmount, Converter={StaticResource Money}}"
                                                   Style="{StaticResource CancelledAwareText}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Padding="8,8" />
                                        <TextBlock Grid.Column="4" Text="{Binding StatusDisplay}"
                                                   Style="{StaticResource CancelledAwareText}"
                                                   VerticalAlignment="Center" Padding="8,8" />
                                    </Grid>
                                </Expander.Header>
                                <Border Background="#F8FAFC" BorderBrush="{StaticResource ReportBorderBrush}"
                                        BorderThickness="0,1,0,0" Padding="12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="1.2*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Mahsulot" FontWeight="SemiBold"
                                                       Foreground="{StaticResource ReportSecondaryText}" Padding="6,6" />
                                            <TextBlock Grid.Column="1" Text="Narx" FontWeight="SemiBold"
                                                       Foreground="{StaticResource ReportSecondaryText}"
                                                       TextAlignment="Right" Padding="6,6" />
                                            <TextBlock Grid.Column="2" Text="Miqdor" FontWeight="SemiBold"
                                                       Foreground="{StaticResource ReportSecondaryText}"
                                                       TextAlignment="Right" Padding="6,6" />
                                            <TextBlock Grid.Column="3" Text="Summa" FontWeight="SemiBold"
                                                       Foreground="{StaticResource ReportSecondaryText}"
                                                       TextAlignment="Right" Padding="6,6" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding DataContext.SelectedSaleDetail.Items, RelativeSource={RelativeSource AncestorType=ListView}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid MinHeight="36">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="3*" />
                                                            <ColumnDefinition Width="1.2*" />
                                                            <ColumnDefinition Width="1.2*" />
                                                            <ColumnDefinition Width="1.2*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding ProductName}"
                                                                   VerticalAlignment="Center" Padding="6,6" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding UnitPrice, Converter={StaticResource Money}}"
                                                                   VerticalAlignment="Center" TextAlignment="Right"
                                                                   Padding="6,6" />
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Quantity, StringFormat={}{0:0.###}}" />
                                                            <TextBlock Text="{Binding Unit}" Margin="4,0,0,0" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding LineTotal, Converter={StaticResource Money}}"
                                                                   VerticalAlignment="Center" TextAlignment="Right"
                                                                   FontWeight="SemiBold" Padding="6,6" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <UniformGrid Columns="3" Margin="0,10,0,0">
                                            <Border Background="{StaticResource ReportCardBackground}"
                                                    CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <TextBlock Text="Jami" Style="{StaticResource ReportCardLabel}" />
                                                    <TextBlock Text="{Binding DataContext.SelectedSaleDetail.TotalAmount, Converter={StaticResource Money}, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                               FontSize="20" FontWeight="SemiBold"
                                                               Foreground="{StaticResource ReportPrimaryText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource ReportCardBackground}"
                                                    CornerRadius="8" Padding="12" Margin="4,0">
                                                <StackPanel>
                                                    <TextBlock Text="Mijozdan olingan"
                                                               Style="{StaticResource ReportCardLabel}" />
                                                    <TextBlock Text="{Binding DataContext.SelectedSaleDetail.ReceivedAmount, Converter={StaticResource Money}, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                               FontSize="20" FontWeight="SemiBold"
                                                               Foreground="{StaticResource ReportPrimaryText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource ReportCardBackground}"
                                                    CornerRadius="8" Padding="12" Margin="8,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="Qaytim" Style="{StaticResource ReportCardLabel}" />
                                                    <TextBlock Text="{Binding DataContext.SelectedSaleDetail.ChangeAmount, Converter={StaticResource Money}, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                               FontSize="20" FontWeight="SemiBold"
                                                               Foreground="{StaticResource ReportSuccessText}" />
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                        <TextBlock Margin="0,10,0,0">
                                            <Run Text="To'lov turi: " />
                                            <Run Text="{Binding DataContext.SelectedSaleDetail.PaymentMethod, RelativeSource={RelativeSource AncestorType=ListView}}" />
                                        </TextBlock>
                                        <TextBlock Text="Sotuv ma'lumotlari yuklanmoqda..."
                                                   Foreground="{StaticResource ReportSecondaryText}"
                                                   Margin="0,8,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsLoadingSaleDetail, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                     Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding DataContext.SaleDetailError, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                   Foreground="{StaticResource ReportDangerText}"
                                                   TextWrapping="Wrap" Margin="0,8,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.SaleDetailError, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                     Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DataContext.SaleDetailError, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                     Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Expander>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </Grid>

        </Border>


        <!-- =========================
             ERROR
             ========================= -->

        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Foreground="#DC2626"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />

    </Grid>

</UserControl>