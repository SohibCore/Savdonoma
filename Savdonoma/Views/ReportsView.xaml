<UserControl x:Class="Savdonoma.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:Savdonoma.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1200">

    <UserControl.Resources>

        <conv:MoneyConverter x:Key="Money" />

        <SolidColorBrush x:Key="ReportCardBackground"
                         Color="#FFFFFF" />

        <SolidColorBrush x:Key="ReportBorderBrush"
                         Color="#E5E7EB" />

        <SolidColorBrush x:Key="ReportPrimaryText"
                         Color="#111827" />

        <SolidColorBrush x:Key="ReportSecondaryText"
                         Color="#6B7280" />

        <SolidColorBrush x:Key="ReportSuccessBackground"
                         Color="#ECFDF3" />

        <SolidColorBrush x:Key="ReportSuccessText"
                         Color="#15803D" />

        <SolidColorBrush x:Key="ReportDangerBackground"
                         Color="#FEF2F2" />

        <SolidColorBrush x:Key="ReportDangerText"
                         Color="#DC2626" />

        <Style x:Key="ReportCard"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{StaticResource ReportCardBackground}" />

            <Setter Property="BorderBrush"
                    Value="{StaticResource ReportBorderBrush}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="CornerRadius"
                    Value="10" />

            <Setter Property="Padding"
                    Value="18" />

        </Style>

        <Style x:Key="ReportCardLabel"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13" />

            <Setter Property="Foreground"
                    Value="{StaticResource ReportSecondaryText}" />

            <Setter Property="FontWeight"
                    Value="Medium" />

        </Style>

        <Style x:Key="ReportCardValue"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="24" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Foreground"
                    Value="{StaticResource ReportPrimaryText}" />

        </Style>

        <Style x:Key="CancelledAwareText"
               TargetType="TextBlock">

            <Setter Property="VerticalAlignment"
                    Value="Center" />

            <Setter Property="Foreground"
                    Value="{StaticResource ReportPrimaryText}" />

            <Setter Property="FontSize"
                    Value="14" />

            <Style.Triggers>

                <DataTrigger Binding="{Binding Status}"
                             Value="Cancelled">

                    <Setter Property="Foreground"
                            Value="#9CA3AF" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>


    <!-- UserControl ning YAGONA Content'i -->
    <Grid Background="Transparent"
          Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />

            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>


        <!-- =========================
             HEADER
             ========================= -->

        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*" />

                <ColumnDefinition Width="Auto" />

            </Grid.ColumnDefinitions>


            <!-- Title -->

            <StackPanel Grid.Column="0">

                <TextBlock Text="Hisobotlar"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ReportPrimaryText}" />

                <TextBlock Text="Savdo natijalari va cheklar statistikasi"
                           FontSize="13"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource ReportSecondaryText}" />

            </StackPanel>


            <!-- Filters -->

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">


                <Border Background="{StaticResource ReportCardBackground}"
                        BorderBrush="{StaticResource ReportBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,2"
                        Margin="0,0,8,0">

                    <DatePicker SelectedDate="{Binding FromDate}"
                                SelectedDateFormat="Short"
                                Width="125"
                                Height="34"
                                BorderThickness="0" />

                </Border>


                <TextBlock Text="—"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="{StaticResource ReportSecondaryText}" />


                <Border Background="{StaticResource ReportCardBackground}"
                        BorderBrush="{StaticResource ReportBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,2"
                        Margin="0,0,12,0">

                    <DatePicker SelectedDate="{Binding ToDate}"
                                SelectedDateFormat="Short"
                                Width="125"
                                Height="34"
                                BorderThickness="0" />

                </Border>


                <ui:Button Content="Bugun"
                           Command="{Binding ShowTodayCommand}"
                           MinHeight="38"
                           Margin="0,0,6,0" />

                <ui:Button Content="Hafta"
                           Command="{Binding ShowWeekCommand}"
                           MinHeight="38"
                           Margin="0,0,6,0" />

                <ui:Button Content="Oy"
                           Command="{Binding ShowMonthCommand}"
                           MinHeight="38"
                           Margin="0,0,10,0" />

                <ui:Button Content="↻ Yangilash"
                           Command="{Binding RefreshCommand}"
                           MinHeight="38" />

            </StackPanel>

        </Grid>


        <!-- =========================
             KPI CARDS
             ========================= -->

        <Grid Grid.Row="1"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="2*" />

                <ColumnDefinition Width="*" />

                <ColumnDefinition Width="*" />

                <ColumnDefinition Width="*" />

                <ColumnDefinition Width="*" />

            </Grid.ColumnDefinitions>


            <!-- Jami -->

            <Border Grid.Column="0"
                    Style="{StaticResource ReportCard}"
                    Margin="0,0,10,0">

                <StackPanel>

                    <TextBlock Text="JAMI SAVDO"
                               Style="{StaticResource ReportCardLabel}" />

                    <TextBlock Text="{Binding TotalAmount, Converter={StaticResource Money}}"
                               Style="{StaticResource ReportCardValue}"
                               Margin="0,8,0,0" />

                    <TextBlock Text="so'm"
                               FontSize="12"
                               Foreground="{StaticResource ReportSecondaryText}"
                               Margin="0,2,0,0" />

                </StackPanel>

            </Border>


            <!-- Cheklar -->

            <Border Grid.Column="1"
                    Style="{StaticResource ReportCard}"
                    Margin="0,0,10,0">

                <StackPanel>

                    <TextBlock Text="CHEKLAR"
                               Style="{StaticResource ReportCardLabel}" />

                    <TextBlock Text="{Binding SalesCount}"
                               Style="{StaticResource ReportCardValue}"
                               Margin="0,8,0,0" />

                    <TextBlock FontSize="12"
                               Foreground="{StaticResource ReportSecondaryText}"
                               Margin="0,3,0,0">

                        <Run Text="Bekor: " />

                        <Run Text="{Binding CancelledCount}" />

                    </TextBlock>

                </StackPanel>

            </Border>


            <!-- Naqd -->

            <Border Grid.Column="2"
                    Style="{StaticResource ReportCard}"
                    Margin="0,0,10,0">

                <StackPanel>

                    <TextBlock Text="NAQD"
                               Style="{StaticResource ReportCardLabel}" />

                    <TextBlock Text="{Binding CashAmount, Converter={StaticResource Money}}"
                               Style="{StaticResource ReportCardValue}"
                               Margin="0,8,0,0" />

                    <TextBlock Text="so'm"
                               FontSize="12"
                               Foreground="{StaticResource ReportSecondaryText}"
                               Margin="0,2,0,0" />

                </StackPanel>

            </Border>


            <!-- Karta -->

            <Border Grid.Column="3"
                    Style="{StaticResource ReportCard}"
                    Margin="0,0,10,0">

                <StackPanel>

                    <TextBlock Text="KARTA"
                               Style="{StaticResource ReportCardLabel}" />

                    <TextBlock Text="{Binding CardAmount, Converter={StaticResource Money}}"
                               Style="{StaticResource ReportCardValue}"
                               Margin="0,8,0,0" />

                    <TextBlock Text="so'm"
                               FontSize="12"
                               Foreground="{StaticResource ReportSecondaryText}"
                               Margin="0,2,0,0" />

                </StackPanel>

            </Border>


            <!-- O'rtacha -->

            <Border Grid.Column="4"
                    Style="{StaticResource ReportCard}">

                <StackPanel>

                    <TextBlock Text="O'RTACHA CHEK"
                               Style="{StaticResource ReportCardLabel}" />

                    <TextBlock Text="{Binding AverageCheck, Converter={StaticResource Money}}"
                               Style="{StaticResource ReportCardValue}"
                               Margin="0,8,0,0" />

                    <TextBlock Text="so'm"
                               FontSize="12"
                               Foreground="{StaticResource ReportSecondaryText}"
                               Margin="0,2,0,0" />

                </StackPanel>

            </Border>

        </Grid>


        <!-- =========================
             SALES
             ========================= -->

        <Border Grid.Row="2"
                Style="{StaticResource ReportCard}">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="*" />

                </Grid.RowDefinitions>


                <!-- Sales header -->

                <Grid Grid.Row="0"
                      Margin="0,0,0,16">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="Auto" />

                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Cheklar"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ReportPrimaryText}" />

                        <TextBlock Text="Tanlangan sana oralig'idagi savdolar"
                                   FontSize="12"
                                   Margin="0,3,0,0"
                                   Foreground="{StaticResource ReportSecondaryText}" />

                    </StackPanel>


                    <ui:Button Grid.Column="1"
                               Content="Bekor qilish"
                               Command="{Binding CancelSaleCommand}"
                               MinHeight="40"
                               Padding="18,0" />

                </Grid>


                <!-- DataGrid -->

                <ListView Grid.Row="1"
                          ItemsSource="{Binding Sales}"
                          SelectedItem="{Binding SelectedSale, Mode=TwoWay}"
                          SelectionMode="Single"
                          Background="Transparent"
                          BorderThickness="0"
                          FontSize="14"
                          SelectionChanged="DataGrid_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Height" Value="46" />
                                    <Setter Property="Padding" Value="14,0" />
                                    <Setter Property="Background" Value="#F8FAFC" />
                                    <Setter Property="BorderBrush" Value="#E5E7EB" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="{StaticResource ReportPrimaryText}" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Header="CHEK RAQAMI" Width="220">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Number}" Style="{StaticResource CancelledAwareText}"
                                                   FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="SANA VA VAQT" Width="220">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Time, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                                   Style="{StaticResource CancelledAwareText}" Margin="12,0"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="TO'LOV" Width="180">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PaymentMethod}" Style="{StaticResource CancelledAwareText}"
                                                   Margin="12,0" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="SUMMA" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TotalAmount, Converter={StaticResource Money}}"
                                                   Style="{StaticResource CancelledAwareText}"
                                                   HorizontalAlignment="Right" TextAlignment="Right" Margin="12,0"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="HOLAT" Width="180">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource CancelledAwareText}"
                                                   Margin="12,0" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

            </Grid>

        </Border>


        <!-- =========================
             ERROR
             ========================= -->

        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Foreground="#DC2626"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />

    </Grid>

</UserControl>