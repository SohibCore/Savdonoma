<UserControl x:Class="Savdonoma.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:Savdonoma.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1200"
             Background="#F8FAFC">

    <UserControl.Resources>

        <conv:MoneyConverter x:Key="Money" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="ReportCardBackground"
                         Color="#FFFFFF" />

        <SolidColorBrush x:Key="ReportBorderBrush"
                         Color="#E5E7EB" />

        <SolidColorBrush x:Key="ReportPrimaryText"
                         Color="#111827" />

        <SolidColorBrush x:Key="ReportSecondaryText"
                         Color="#6B7280" />

        <SolidColorBrush x:Key="ReportSuccessBackground"
                         Color="#ECFDF3" />

        <SolidColorBrush x:Key="ReportSuccessText"
                         Color="#15803D" />

        <SolidColorBrush x:Key="ReportDangerBackground"
                         Color="#FEF2F2" />

        <SolidColorBrush x:Key="ReportDangerText"
                         Color="#DC2626" />

        <Style x:Key="ReportColumnCell"
               TargetType="Border">
            <Setter Property="BorderBrush"
                    Value="#EEF2F6" />
            <Setter Property="BorderThickness"
                    Value="0,0,0,1" />
            <Setter Property="Padding"
                    Value="12,8" />
        </Style>

        <Style x:Key="ReportDetailHeaderCell"
               TargetType="Border"
               BasedOn="{StaticResource ReportColumnCell}">
            <Setter Property="Background"
                    Value="#F1F5F9" />
            <Setter Property="BorderBrush"
                    Value="#E2E8F0" />
            <Setter Property="TextElement.Foreground"
                    Value="#64748B" />
            <Setter Property="TextElement.FontSize"
                    Value="12" />
        </Style>

        <Style x:Key="ReportDetailsPanelStyle"
               TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="MaxHeight" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="MaxHeight" Value="9999" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1"
                                                 Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="0"
                                                 Duration="0:0:0.1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReportSaleRowItemStyle"
               TargetType="ListViewItem"
               BasedOn="{StaticResource TableRowStyle}">
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Background"
                    Value="White" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"
                            Value="#F0F4FF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background"
                            Value="#EEF3FF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReportCard"
               TargetType="Border"
               BasedOn="{StaticResource AppCard}" />

        <Style x:Key="ReportCardLabel"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13" />

            <Setter Property="Foreground"
                    Value="{StaticResource ReportSecondaryText}" />

            <Setter Property="FontWeight"
                    Value="Medium" />

        </Style>

        <Style x:Key="ReportCardValue"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="24" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Foreground"
                    Value="{StaticResource ReportPrimaryText}" />

        </Style>

        <Style x:Key="CancelledAwareText"
               TargetType="TextBlock">

            <Setter Property="VerticalAlignment"
                    Value="Center" />

            <Setter Property="Foreground"
                    Value="{StaticResource ReportPrimaryText}" />

            <Setter Property="FontSize"
                    Value="14" />

            <Style.Triggers>

                <DataTrigger Binding="{Binding Status}"
                             Value="Cancelled">

                    <Setter Property="Foreground"
                            Value="#9CA3AF" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>


    <!-- UserControl ning YAGONA Content'i -->
    <Grid Background="Transparent"
          Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />

            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>


        <!-- =========================
             YUQORI PANEL: sana oralig'i va tez tanlash
             ========================= -->

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource AppSegmentGroup}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Bugun" Style="{StaticResource AppSegmentButton}"
                            Tag="{Binding IsTodayRange}" Command="{Binding ShowTodayCommand}" />
                    <Button Content="Shu hafta" Style="{StaticResource AppSegmentButton}"
                            Tag="{Binding IsWeekRange}" Command="{Binding ShowWeekCommand}" />
                    <Button Content="Shu oy" Style="{StaticResource AppSegmentButton}"
                            Tag="{Binding IsMonthRange}" Command="{Binding ShowMonthCommand}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="18" Foreground="{StaticResource AppTextSecondary}"
                               VerticalAlignment="Center" />
                <Border Background="White" BorderBrush="{StaticResource AppCardBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="6,1" Margin="8,0,8,0">
                    <DatePicker SelectedDate="{Binding FromDate}" SelectedDateFormat="Short"
                                Width="125" Height="34" BorderThickness="0" />
                </Border>
                <TextBlock Text="—" VerticalAlignment="Center" Foreground="{StaticResource AppTextMuted}" />
                <Border Background="White" BorderBrush="{StaticResource AppCardBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="6,1" Margin="8,0,0,0">
                    <DatePicker SelectedDate="{Binding ToDate}" SelectedDateFormat="Short"
                                Width="125" Height="34" BorderThickness="0" />
                </Border>
            </StackPanel>

            <ui:Button Grid.Column="2" Content="Yangilash" Icon="{ui:SymbolIcon ArrowClockwise24}"
                       Appearance="Secondary" Command="{Binding RefreshCommand}"
                       MinHeight="38" Padding="14,0" VerticalAlignment="Center" />
        </Grid>


        <!-- =========================
             KPI KARTALAR
             ========================= -->

        <UniformGrid Grid.Row="1" Columns="5" Margin="-8,0,-8,16">

            <Border Style="{StaticResource AppCard}" Margin="8,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Jami savdo" Style="{StaticResource AppKpiLabel}" />
                        <Border Style="{StaticResource AppIconBadge}" Background="{StaticResource AppBlueSoft}"
                                HorizontalAlignment="Right">
                            <ui:SymbolIcon Symbol="Money24" FontSize="20" Foreground="{StaticResource AppBlue}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock Style="{StaticResource AppKpiValue}">
                        <Run Text="{Binding TotalAmount, Converter={StaticResource Money}, Mode=OneWay}" />
                        <Run Text="so‘m" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" />
                    </TextBlock>
                    <TextBlock Text="Tugallangan sotuvlar summasi" Style="{StaticResource AppKpiHint}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AppCard}" Margin="8,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Cheklar" Style="{StaticResource AppKpiLabel}" />
                        <Border Style="{StaticResource AppIconBadge}" Background="{StaticResource AppGreenSoft}"
                                HorizontalAlignment="Right">
                            <ui:SymbolIcon Symbol="Receipt24" FontSize="20" Foreground="{StaticResource AppGreen}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding SalesCount}" Style="{StaticResource AppKpiValue}" />
                    <TextBlock Style="{StaticResource AppKpiHint}">
                        <Run Text="Bekor qilingan: " /><Run Text="{Binding CancelledCount, Mode=OneWay}"
                                                            Foreground="{StaticResource AppRed}" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AppCard}" Margin="8,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Naqd" Style="{StaticResource AppKpiLabel}" />
                        <Border Style="{StaticResource AppIconBadge}" Background="{StaticResource AppGreenSoft}"
                                HorizontalAlignment="Right">
                            <ui:SymbolIcon Symbol="Wallet24" FontSize="20" Foreground="{StaticResource AppGreen}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock Style="{StaticResource AppKpiValue}">
                        <Run Text="{Binding CashAmount, Converter={StaticResource Money}, Mode=OneWay}" />
                        <Run Text="so‘m" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" />
                    </TextBlock>
                    <TextBlock Text="Naqd pul bilan to‘langan" Style="{StaticResource AppKpiHint}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AppCard}" Margin="8,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Karta" Style="{StaticResource AppKpiLabel}" />
                        <Border Style="{StaticResource AppIconBadge}" Background="{StaticResource AppBlueSoft}"
                                HorizontalAlignment="Right">
                            <ui:SymbolIcon Symbol="Payment24" FontSize="20" Foreground="{StaticResource AppBlue}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock Style="{StaticResource AppKpiValue}">
                        <Run Text="{Binding CardAmount, Converter={StaticResource Money}, Mode=OneWay}" />
                        <Run Text="so‘m" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" />
                    </TextBlock>
                    <TextBlock Text="Karta orqali to‘langan" Style="{StaticResource AppKpiHint}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AppCard}" Margin="8,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="O‘rtacha chek" Style="{StaticResource AppKpiLabel}" />
                        <Border Style="{StaticResource AppIconBadge}" Background="{StaticResource AppIndigoSoft}"
                                HorizontalAlignment="Right">
                            <ui:SymbolIcon Symbol="DataTrending24" FontSize="20" Foreground="{StaticResource AppIndigo}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock Style="{StaticResource AppKpiValue}">
                        <Run Text="{Binding AverageCheck, Converter={StaticResource Money}, Mode=OneWay}" />
                        <Run Text="so‘m" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" />
                    </TextBlock>
                    <TextBlock Text="Bir chekka to‘g‘ri keladi" Style="{StaticResource AppKpiHint}" />
                </StackPanel>
            </Border>
        </UniformGrid>


        <!-- =========================
             SALES
             ========================= -->

        <Border Grid.Row="2"
                Style="{StaticResource ReportCard}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>


                <!-- Sales header -->

                <Grid Grid.Row="0"
                      Margin="0,0,0,16">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="Auto" />

                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Style="{StaticResource AppIconBadge}" Background="{StaticResource AppGreenSoft}">
                            <ui:SymbolIcon Symbol="ReceiptMoney24" FontSize="20" Foreground="{StaticResource AppGreen}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Cheklar" Style="{StaticResource AppCardTitle}" />
                            <TextBlock Text="{Binding SalesSubtitle}" Style="{StaticResource AppCardSubtitle}" />
                        </StackPanel>
                    </StackPanel>


                    <ui:Button Grid.Column="1"
                               Content="Bekor qilish"
                               Icon="{ui:SymbolIcon DismissCircle24}"
                               Appearance="Danger"
                               Command="{Binding CancelSaleCommand}"
                               Visibility="{Binding CanCancelSales, Converter={StaticResource BoolToVisibility}}"
                               MinHeight="40"
                               Padding="18,0" />

                </Grid>


                <Grid Grid.Row="1" MinHeight="42" Background="#F1F5F9"
                      Width="{Binding ActualWidth, ElementName=SalesList}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="0.7*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="38" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource ReportDetailHeaderCell}">
                        <TextBlock Text="CHEK RAQAMI" FontWeight="SemiBold"
                                   Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource ReportDetailHeaderCell}">
                        <TextBlock Text="SANA VA VAQT" FontWeight="SemiBold"
                                   Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource ReportDetailHeaderCell}">
                        <TextBlock Text="TO'LOV" FontWeight="SemiBold"
                                   Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource ReportDetailHeaderCell}">
                        <TextBlock Text="SUMMA" FontWeight="SemiBold"
                                   Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource ReportDetailHeaderCell}">
                        <TextBlock Text="HOLAT" FontWeight="SemiBold"
                                   Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="5" Style="{StaticResource ReportDetailHeaderCell}" />
                </Grid>

                <ListView x:Name="SalesList" Grid.Row="2"
                          ItemsSource="{Binding Sales}"
                          SelectedItem="{Binding SelectedSale, Mode=TwoWay}"
                          SelectionMode="Single"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          FontSize="14"
                          ScrollViewer.CanContentScroll="False"
                          VirtualizingPanel.IsVirtualizing="False"
                          PreviewMouseLeftButtonDown="SalesList_PreviewMouseLeftButtonDown"
                          ItemContainerStyle="{StaticResource ReportSaleRowItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <!-- Row header — bitta click bilan ochiladi -->
                                <Grid MinHeight="44" HorizontalAlignment="Stretch"
                                      Width="{Binding ActualWidth, ElementName=SalesList}"
                                      Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="0.7*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="38" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource ReportColumnCell}">
                                        <TextBlock Text="{Binding Number}"
                                                   Style="{StaticResource CancelledAwareText}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource ReportColumnCell}">
                                        <TextBlock Text="{Binding Time, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                                   Style="{StaticResource CancelledAwareText}"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource ReportColumnCell}">
                                        <TextBlock Text="{Binding PaymentMethod}"
                                                   Style="{StaticResource CancelledAwareText}"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource ReportColumnCell}">
                                        <TextBlock Text="{Binding TotalAmount, Converter={StaticResource Money}}"
                                                   Style="{StaticResource CancelledAwareText}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Column="4" Style="{StaticResource ReportColumnCell}">
                                        <Border CornerRadius="14" Padding="9,4"
                                                HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E7F8F0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                            <Setter Property="Background" Value="#FEF2F2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="16" Height="16"
                                                        CornerRadius="8"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#10A37F" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                                    <Setter Property="Background" Value="#DC2626" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="✓" Foreground="White"
                                                               FontSize="10" FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="✓" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                                        <Setter Property="Text" Value="!" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding StatusDisplay}" FontSize="12"
                                                           VerticalAlignment="Center" Margin="7,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#07815F" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                                    <Setter Property="Foreground" Value="#B91C1C" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                    <!-- Chevron icon -->
                                    <Border Grid.Column="5" Style="{StaticResource ReportColumnCell}"
                                            HorizontalAlignment="Stretch">
                                        <TextBlock Text="⌄" FontSize="18"
                                                   Foreground="{StaticResource ReportSecondaryText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform x:Name="ChevronRotate" Angle="0" />
                                            </TextBlock.RenderTransform>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation
                                                                            Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                                                            To="180" Duration="0:0:0.2">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation
                                                                            Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                                                            To="0" Duration="0:0:0.2">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                                <Border Background="#F8FAFC" BorderBrush="{StaticResource ReportBorderBrush}"
                                        BorderThickness="0,1,0,0" Padding="12"
                                        Style="{StaticResource ReportDetailsPanelStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,0,0,10">
                                            <ui:Button Content="Chekni ko‘rish"
                                                       Command="{Binding DataContext.ShowReceiptCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                       CommandParameter="{Binding}"
                                                       Appearance="Primary"
                                                       MinHeight="36"
                                                       Padding="14,0" />
                                        </StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="1.2*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource ReportColumnCell}">
                                                <TextBlock Text="Mahsulot" FontWeight="SemiBold"
                                                           Foreground="{StaticResource ReportSecondaryText}" />
                                            </Border>
                                            <Border Grid.Column="1" Style="{StaticResource ReportColumnCell}">
                                                <TextBlock Text="Narx" FontWeight="SemiBold"
                                                           Foreground="{StaticResource ReportSecondaryText}"
                                                           TextAlignment="Right" />
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource ReportColumnCell}">
                                                <TextBlock Text="Miqdor" FontWeight="SemiBold"
                                                           Foreground="{StaticResource ReportSecondaryText}"
                                                           TextAlignment="Right" />
                                            </Border>
                                            <Border Grid.Column="3" Style="{StaticResource ReportColumnCell}">
                                                <TextBlock Text="Summa" FontWeight="SemiBold"
                                                           Foreground="{StaticResource ReportSecondaryText}"
                                                           TextAlignment="Right" />
                                            </Border>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Detail.Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid MinHeight="36">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="3*" />
                                                            <ColumnDefinition Width="1.2*" />
                                                            <ColumnDefinition Width="1.2*" />
                                                            <ColumnDefinition Width="1.2*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Style="{StaticResource ReportColumnCell}">
                                                            <TextBlock Text="{Binding ProductName}" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Border Grid.Column="1" Style="{StaticResource ReportColumnCell}">
                                                            <TextBlock Text="{Binding UnitPrice, Converter={StaticResource Money}}"
                                                                       VerticalAlignment="Center" TextAlignment="Right" />
                                                        </Border>
                                                        <Border Grid.Column="2" Style="{StaticResource ReportColumnCell}">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                <TextBlock Text="{Binding Quantity, StringFormat={}{0:0.###}}" />
                                                                <TextBlock Text="{Binding Unit}" Margin="4,0,0,0" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Grid.Column="3" Style="{StaticResource ReportColumnCell}">
                                                            <TextBlock Text="{Binding LineTotal, Converter={StaticResource Money}}"
                                                                       VerticalAlignment="Center" TextAlignment="Right"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <UniformGrid Columns="5" Margin="0,10,0,0">
                                            <Border Background="#F1F5F9" BorderBrush="{StaticResource ReportBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <TextBlock Text="Jami" Style="{StaticResource ReportCardLabel}" />
                                                    <TextBlock Text="{Binding Detail.TotalAmount, Converter={StaticResource Money}}"
                                                               FontSize="20" FontWeight="SemiBold"
                                                               Foreground="{StaticResource ReportPrimaryText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#F1F5F9" BorderBrush="{StaticResource ReportBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8" Padding="12" Margin="4,0">
                                                <StackPanel>
                                                    <TextBlock Text="Mijozdan olingan"
                                                               Style="{StaticResource ReportCardLabel}" />
                                                    <TextBlock Text="{Binding Detail.ReceivedAmount, Converter={StaticResource Money}}"
                                                               FontSize="20" FontWeight="SemiBold"
                                                               Foreground="{StaticResource ReportPrimaryText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#F1F5F9" BorderBrush="{StaticResource ReportBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8" Padding="12" Margin="8,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="Qaytim" Style="{StaticResource ReportCardLabel}" />
                                                    <TextBlock Text="{Binding Detail.ChangeAmount, Converter={StaticResource Money}}"
                                                               FontSize="20" FontWeight="SemiBold"
                                                               Foreground="{StaticResource ReportSuccessText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#F1F5F9" BorderBrush="{StaticResource ReportBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8" Padding="12" Margin="4,0">
                                                <StackPanel>
                                                    <TextBlock Text="To'lov turi" Style="{StaticResource ReportCardLabel}" />
                                                    <TextBlock Text="{Binding Detail.PaymentMethod}"
                                                               FontSize="18" FontWeight="SemiBold"
                                                               Foreground="{StaticResource ReportPrimaryText}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#F1F5F9" BorderBrush="{StaticResource ReportBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8" Padding="12" Margin="8,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="Sotuvchi" Style="{StaticResource ReportCardLabel}" />
                                                    <TextBlock Text="{Binding Detail.SellerName}"
                                                               FontSize="18" FontWeight="SemiBold"
                                                               Foreground="{StaticResource ReportPrimaryText}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                        <TextBlock Text="Sotuv ma'lumotlari yuklanmoqda..."
                                                   Foreground="{StaticResource ReportSecondaryText}"
                                                   Margin="0,8,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLoadingDetail}"
                                                                     Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding DetailError}"
                                                   Foreground="{StaticResource ReportDangerText}"
                                                   TextWrapping="Wrap" Margin="0,8,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DetailError}"
                                                                     Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DetailError}"
                                                                     Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </Grid>

        </Border>


        <!-- =========================
             ERROR
             ========================= -->

        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Style="{StaticResource AppErrorBanner}"
                   Margin="0,10,0,0" />

    </Grid>

</UserControl>
