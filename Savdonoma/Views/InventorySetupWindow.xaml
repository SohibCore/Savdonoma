<ui:FluentWindow x:Class="Savdonoma.Views.InventorySetupWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="TijoratUz: qoldiq sozlamasi"
                 Icon="pack://application:,,,/TijoratUz;component/TijoratUz.ico"
                 Width="680"
                 Height="460"
                 MinWidth="640"
                 MinHeight="420"
                 ResizeMode="CanResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True">
    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Do'kon rejimi" />

        <Grid Grid.Row="1" Margin="24">
            <Border Width="560"
                    MaxWidth="720"
                    Padding="30"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" VerticalAlignment="Center">
                        <TextBlock Text="Do'kon qaysi rejimda ishlaydi?"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Ishlash usulini tanlang. Bu sozlama sotuv va mahsulot qoldig'ini boshqaradi."
                                   FontSize="14"
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,24" />

                        <CheckBox x:Name="InventoryCheckBox"
                                  Content="Qoldiqni yuritish"
                                  IsChecked="True"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Foreground="#1E293B"
                                  Padding="4" />

                        <Border Margin="0,14,0,0"
                                Padding="14"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="10">
                            <TextBlock Text="Belgilangan: har bir mahsulot qoldig'i ko'rsatiladi, sotuvda tekshiriladi va kamaytiriladi.&#xA;Belgilanmagan: do'kon qoldiqsiz ishlaydi."
                                       TextWrapping="Wrap"
                                       LineHeight="21"
                                       Foreground="#475569" />
                        </Border>
                    </StackPanel>

                    <Button Grid.Row="1"
                            Content="Davom etish"
                            Width="150"
                            Height="42"
                            HorizontalAlignment="Right"
                            Margin="0,24,0,0"
                            IsDefault="True"
                            Click="Continue_Click" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
