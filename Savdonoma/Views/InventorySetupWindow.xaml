<ui:FluentWindow x:Class="Savdonoma.Views.InventorySetupWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="TijoratUz: do'kon rejimi"
                 Icon="pack://application:,,,/TijoratUz;component/TijoratUz.ico"
                 Width="680"
                 Height="460"
                 MinWidth="640"
                 MinHeight="420"
                 ResizeMode="CanResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True">
    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Do'kon rejimi" />

        <Grid Grid.Row="1" Margin="24">
            <Border Width="560"
                    MaxWidth="720"
                    Padding="30"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" VerticalAlignment="Center">
                        <TextBlock Text="Do‘kon qaysi rejimda ishlaydi?"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Ishlash usulini tanlang. Bu sozlama sotuv va mahsulot qoldig‘ini boshqaradi."
                                   FontSize="14"
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,24" />

                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" CornerRadius="12" BorderThickness="1"
                                    Margin="0,0,6,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F8FAFC" />
                                        <Setter Property="BorderBrush" Value="#E2E8F0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=WithStockRadio}"
                                                         Value="True">
                                                <Setter Property="Background" Value="#EFF6FF" />
                                                <Setter Property="BorderBrush" Value="#3B82F6" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <RadioButton x:Name="WithStockRadio" GroupName="InventoryMode"
                                             IsChecked="True" Padding="14"
                                             HorizontalContentAlignment="Stretch">
                                    <StackPanel>
                                        <TextBlock Text="Qoldiq bilan" FontSize="15"
                                                   FontWeight="SemiBold" Foreground="#1E293B" />
                                        <TextBlock Text="Mahsulot qoldig‘i yuritiladi va sotuvda kamayadi."
                                                   FontSize="12" Foreground="#64748B"
                                                   TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                </RadioButton>
                            </Border>

                            <Border Grid.Column="1" CornerRadius="12" BorderThickness="1"
                                    Margin="6,0,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F8FAFC" />
                                        <Setter Property="BorderBrush" Value="#E2E8F0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=WithoutStockRadio}"
                                                         Value="True">
                                                <Setter Property="Background" Value="#EFF6FF" />
                                                <Setter Property="BorderBrush" Value="#3B82F6" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <RadioButton x:Name="WithoutStockRadio" GroupName="InventoryMode"
                                             Padding="14" HorizontalContentAlignment="Stretch">
                                    <StackPanel>
                                        <TextBlock Text="Qoldiqsiz" FontSize="15"
                                                   FontWeight="SemiBold" Foreground="#1E293B" />
                                        <TextBlock Text="Sotuvda mahsulot qoldig‘i hisoblanmaydi."
                                                   FontSize="12" Foreground="#64748B"
                                                   TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                </RadioButton>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <Button x:Name="ContinueButton"
                            Grid.Row="1"
                            Content="Saqlash"
                            Width="150"
                            Height="42"
                            HorizontalAlignment="Right"
                            Margin="0,24,0,0"
                            IsDefault="True"
                            Click="Continue_Click" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
