<UserControl x:Class="Savdonoma.Views.ContactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="#F8FAFC">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="22,22" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="1" Opacity="0.06" Color="#0F172A" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconCircle" TargetType="Border">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="72" />
            <Setter Property="CornerRadius" Value="36" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="CardHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style x:Key="CardHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Bosiladigan karta: hoverda chegarasi ko'k bo'ladi -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Style="{StaticResource Card}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F8FAFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ijtimoiy tarmoq "tugmasi" (hozircha nofaol) -->
        <Style x:Key="SocialChip" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="ToolTip" Value="Tez orada" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,4,4,16">

            <!-- ================= SARLAVHA BANNERI ================= -->
            <Border CornerRadius="18" BorderBrush="#DBEAFE" BorderThickness="1" ClipToBounds="True" MinHeight="150">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#EFF6FF" Offset="0" />
                        <GradientStop Color="#E0EAFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <!-- Fon bezaklari -->
                    <Ellipse Width="320" Height="320" Fill="#DBE6FE" Opacity="0.7"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-60,40,-120" />
                    <Ellipse Width="200" Height="200" Fill="#E6EEFF"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,300,-110" />

                    <Grid Margin="24,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="92" Height="92" CornerRadius="22" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3B82F6" Offset="0" />
                                    <GradientStop Color="#2563EB" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25" Color="#2563EB" />
                            </Border.Effect>
                            <ui:SymbolIcon Symbol="Headset24" FontSize="46" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Bog‘lanish" FontSize="32" FontWeight="Bold" Foreground="#0F172A" />
                            <TextBlock Text="Biz bilan bog‘laning, savollaringizga javob oling"
                                       FontSize="16" Foreground="#334155" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- O'ng tomondagi bezak: chat pufakchasi + qo'llab-quvvatlash belgisi -->
                        <Grid Grid.Column="2" Width="230" Height="120" VerticalAlignment="Center">
                            <Border Width="82" Height="56" CornerRadius="16" Background="White"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,8,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.12" Color="#1E3A8A" />
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Fill="#3B82F6" Margin="3,0" />
                                    <Ellipse Width="10" Height="10" Fill="#3B82F6" Margin="3,0" />
                                    <Ellipse Width="10" Height="10" Fill="#3B82F6" Margin="3,0" />
                                </StackPanel>
                            </Border>
                            <Border Width="110" Height="110" CornerRadius="55" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#BFDBFE" Offset="0" />
                                        <GradientStop Color="#93C5FD" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ui:SymbolIcon Symbol="PersonSupport24" FontSize="60" Foreground="#1D4ED8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= KONTAKT KARTALARI ================= -->
            <UniformGrid Columns="3" Margin="-8,20,-8,0">

                <!-- Telefon -->
                <Button Style="{StaticResource CardButton}" Margin="8,0" Command="{Binding CopyPhoneCommand}"
                        ToolTip="Raqamni nusxalash">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconCircle}" Background="#DCFCE7">
                            <ui:SymbolIcon Symbol="Call24" Filled="True" FontSize="32" Foreground="#16A34A"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,4,0,0">
                            <TextBlock Text="Telefon orqali" Style="{StaticResource CardHeading}" />
                            <TextBlock Text="{Binding PhoneText}" Style="{StaticResource CardValue}" />
                            <TextBlock Text="{Binding WorkDaysText}" Style="{StaticResource CardHint}" />
                            <TextBlock Text="{Binding WorkHoursText}" Style="{StaticResource CardHint}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Telegram -->
                <Button Style="{StaticResource CardButton}" Margin="8,0" Command="{Binding OpenTelegramCommand}"
                        ToolTip="Telegramda ochish">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconCircle}" Background="#E0F2FE">
                            <Border Width="50" Height="50" CornerRadius="25" Background="#229ED9">
                                <ui:SymbolIcon Symbol="Send24" Filled="True" FontSize="24" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,4,0,0">
                            <TextBlock Text="Telegram orqali" Style="{StaticResource CardHeading}" />
                            <TextBlock Text="{Binding TelegramText}" Style="{StaticResource CardValue}" />
                            <TextBlock Text="Tezkor javob olish uchun" Style="{StaticResource CardHint}" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Ish vaqti -->
                <Border Style="{StaticResource Card}" Margin="8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconCircle}" Background="#EDE9FE">
                            <ui:SymbolIcon Symbol="Clock24" FontSize="34" Foreground="#7C3AED"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,4,0,0">
                            <TextBlock Text="Ish vaqti" Style="{StaticResource CardHeading}" />
                            <TextBlock Text="{Binding WorkDaysText}" Style="{StaticResource CardHint}" Margin="0,12,0,0" />
                            <TextBlock Text="{Binding WorkHoursText}" Style="{StaticResource CardHint}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Nusxalash va h.k. haqida qisqa xabar -->
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#059669"
                       HorizontalAlignment="Center" Margin="0,10,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- ================= IJTIMOIY TARMOQLAR (hozircha havolasiz) ================= -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="72" Height="72" CornerRadius="16" Background="#EEF2FF" VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="Share24" FontSize="34" Foreground="#4F46E5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,4,0,0">
                        <TextBlock Text="Ijtimoiy tarmoqlar" Style="{StaticResource CardHeading}" />
                        <TextBlock Text="Tez orada ijtimoiy tarmoqlarda ham bo‘lamiz" FontSize="14"
                                   Foreground="#4F46E5" Margin="0,8,0,16" />
                        <UniformGrid Columns="3" HorizontalAlignment="Left" MaxWidth="900">
                            <Border Style="{StaticResource SocialChip}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Send24" FontSize="20" Foreground="#229ED9" />
                                    <TextBlock Text="Telegram" FontSize="15" FontWeight="SemiBold" Foreground="#1E293B"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SocialChip}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Camera24" FontSize="20" Foreground="#DB2777" />
                                    <TextBlock Text="Instagram" FontSize="15" FontWeight="SemiBold" Foreground="#1E293B"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SocialChip}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Globe24" FontSize="20" Foreground="#2563EB" />
                                    <TextBlock Text="Veb-sayt" FontSize="15" FontWeight="SemiBold" Foreground="#1E293B"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
