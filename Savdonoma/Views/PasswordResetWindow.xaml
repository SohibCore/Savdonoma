<ui:FluentWindow x:Class="Savdonoma.Views.PasswordResetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="TijoratUz: parolni tiklash"
        Icon="pack://application:,,,/TijoratUz;component/TijoratUz.ico"
        Width="620" Height="760" MinWidth="560" MinHeight="640"
        Background="#F1F5F9"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="TijoratUz" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Margin="24" Padding="28" Background="White" CornerRadius="16"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Do‘kon egasining parolini tiklash" FontSize="22"
                               FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,8" />
                    <TextBlock Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,18"
                               Text="1. Quyidagi Machine ID va so‘rov kodini ishlab chiquvchiga yuboring.&#xA;2. U sizga tiklash kodini beradi.&#xA;3. Kodni kiriting va yangi parol o‘rnating. Bu oynani yopmang: so‘rov kodi har safar yangi bo‘ladi." />

                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="10" Padding="16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Machine ID:" Foreground="#64748B" Margin="0,0,12,6" />
                            <TextBox Grid.Column="1" Text="{Binding MachineId, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="Consolas" FontSize="16" FontWeight="SemiBold"
                                     BorderThickness="0" Background="Transparent" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="1" Text="So‘rov kodi:" Foreground="#64748B" Margin="0,0,12,6" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RequestCode, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="Consolas" FontSize="16" FontWeight="SemiBold"
                                     BorderThickness="0" Background="Transparent" Margin="0,0,0,6" />

                            <Button Grid.Row="2" Grid.ColumnSpan="2" Content="Nusxa olish"
                                    Command="{Binding CopyRequestCommand}" HorizontalAlignment="Left"
                                    Padding="14,6" Margin="0,6,0,0" />
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding InfoMessage}" Foreground="#16A34A" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <TextBlock Foreground="#475569" Margin="0,0,0,4">
                        <Run Text="Do‘kon egasi logini:" />
                        <Run Text="{Binding OwnerUserName, Mode=OneWay}" FontWeight="SemiBold" Foreground="#0F172A" />
                    </TextBlock>

                    <TextBlock Text="Tiklash kodi" Foreground="#475569" Margin="0,12,0,4" />
                    <TextBox Text="{Binding ResetCode, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" TextWrapping="Wrap" MinHeight="60" Padding="10,8" />

                    <TextBlock Text="Yangi parol" Foreground="#475569" Margin="0,12,0,4" />
                    <PasswordBox x:Name="NewPasswordInput" PasswordChanged="NewPassword_Changed" Height="40" Padding="10,6" />

                    <TextBlock Text="Yangi parolni takrorlang" Foreground="#475569" Margin="0,12,0,4" />
                    <PasswordBox x:Name="ConfirmPasswordInput" PasswordChanged="ConfirmPassword_Changed" Height="40" Padding="10,6" />

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,12,0,0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="Bekor qilish" IsCancel="True" Padding="18,8" Margin="0,0,10,0" />
                        <Button Content="Parolni o‘zgartirish" Command="{Binding ResetCommand}" IsDefault="True"
                                Padding="18,8" Background="#2563EB" Foreground="White" BorderThickness="0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
