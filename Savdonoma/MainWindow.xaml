<ui:FluentWindow x:Class="Savdonoma.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="TijoratUz"
        Icon="pack://application:,,,/TijoratUz;component/TijoratUz.ico"
        Height="760" Width="1240"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMainMenuExpanded}" Value="False">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <DataTrigger Binding="{Binding IsMainMenuExpanded}" Value="False">
                    <Setter Property="Height" Value="58" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavIconStyle" TargetType="Border">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMainMenuExpanded}" Value="False">
                    <Setter Property="Width" Value="44" />
                    <Setter Property="Height" Value="44" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMainMenuExpanded}" Value="False" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"
                                   Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#263653" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMainMenuExpanded}" Value="False" />
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                   Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#2563EB" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavLabelStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMainMenuExpanded}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Yon menyu -->
        <Border Grid.Column="0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="272" />
                    <Setter Property="Padding" Value="20,14,20,18" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMainMenuExpanded}" Value="False">
                            <Setter Property="Width" Value="88" />
                            <Setter Property="Padding" Value="12,14,12,18" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0F172A" Offset="0" />
                    <GradientStop Color="#1E1B4B" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="52" Height="52" CornerRadius="15">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Margin" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMainMenuExpanded}" Value="False">
                                            <Setter Property="Margin" Value="6,0,0,0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#38BDF8" Offset="0" />
                                    <GradientStop Color="#6366F1" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Image Source="pack://application:,,,/TijoratUz;component/TijoratUzLogo.png"
                                   Width="44" Height="44" Stretch="Uniform"
                                   SnapsToDevicePixels="True"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="TijoratUz" Foreground="White" FontSize="21" FontWeight="Bold"
                                       Style="{StaticResource NavLabelStyle}" />
                            <TextBlock Text="Savdo boshqaruvi" Foreground="#94A3B8" FontSize="12" Margin="0,3,0,0"
                                       Style="{StaticResource NavLabelStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="4,10,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMainMenuExpanded}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                CornerRadius="10" Padding="10,7" Margin="0,0,0,6"
                                ToolTip="{Binding InventoryModeTooltip}">
                            <TextBlock Text="{Binding InventoryModeText}" FontSize="12"
                                       FontWeight="SemiBold" Foreground="#BFDBFE" />
                        </Border>
                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                CornerRadius="10" Padding="10,7">
                            <TextBlock Text="{Binding TodayText}" FontSize="12"
                                       FontWeight="SemiBold" Foreground="#CBD5E1" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,18,0,0">
                    <Button Command="{Binding ToggleMainMenuCommand}" Height="42" Margin="0,0,0,10"
                            ToolTip="Asosiy menyuni ochish yoki yopish"
                            BorderThickness="0" FocusVisualStyle="{x:Null}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource NavButtonStyle}" TargetType="Button">
                                <Setter Property="Foreground" Value="#CBD5E1" />
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMainMenuExpanded}" Value="False">
                                        <Setter Property="Height" Value="48" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1E293B" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <TextBlock Text="ASOSIY MENYU" Foreground="#64748B" FontSize="11"
                                       FontWeight="Bold" Margin="12,0,0,0" HorizontalAlignment="Left"
                                       VerticalAlignment="Center" Style="{StaticResource NavLabelStyle}" />
                            <TextBlock Text="‹" Foreground="#94A3B8" FontSize="22" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Style="{StaticResource NavLabelStyle}" />
                            <TextBlock Text="☰" Foreground="#94A3B8" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMainMenuExpanded}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Button>

                    <Button Command="{Binding ShowSaleCommand}" Tag="{Binding IsSaleActive}" ToolTip="Sotuv">
                        <Button.Style>
                            <Style BasedOn="{StaticResource NavButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMainMenuExpanded}" Value="True" />
                                            <Condition Binding="{Binding IsSaleActive}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="#2563EB" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource NavIconStyle}">
                                <TextBlock Text="S" FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Sotuv" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Style="{StaticResource NavLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowProductsCommand}"
                            Visibility="{Binding IsOwner, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Tag="{Binding IsProductsActive}" ToolTip="Mahsulotlar">
                        <Button.Style>
                            <Style BasedOn="{StaticResource NavButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMainMenuExpanded}" Value="True" />
                                            <Condition Binding="{Binding IsProductsActive}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="#2563EB" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource NavIconStyle}">
                                <TextBlock Text="M" FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Mahsulotlar" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Style="{StaticResource NavLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowReportsCommand}" Tag="{Binding IsReportsActive}" ToolTip="Hisobotlar">
                        <Button.Style>
                            <Style BasedOn="{StaticResource NavButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMainMenuExpanded}" Value="True" />
                                            <Condition Binding="{Binding IsReportsActive}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="#2563EB" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource NavIconStyle}">
                                <TextBlock Text="H" FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Hisobot" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Style="{StaticResource NavLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowEmployeesCommand}"
                            Visibility="{Binding IsOwner, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Tag="{Binding IsEmployeesActive}" ToolTip="Xodimlar">
                        <Button.Style>
                            <Style BasedOn="{StaticResource NavButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMainMenuExpanded}" Value="True" />
                                            <Condition Binding="{Binding IsEmployeesActive}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="#2563EB" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource NavIconStyle}">
                                <TextBlock Text="X" FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Xodimlar" FontSize="15" FontWeight="SemiBold"
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource NavLabelStyle}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Menyu pastida: Litsenziya -->
                <StackPanel Grid.Row="3">
                    <Button Click="ContactButton_Click" Height="44" Margin="0,0,0,0"
                            ToolTip="Bog'lanish" Tag="Contact">
                        <Button.Style>
                            <Style BasedOn="{StaticResource NavButtonStyle}" TargetType="Button">
                                <Setter Property="Background" Value="#0F766E" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#115E59" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource NavIconStyle}">
                                <TextBlock Text="@" FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Bog'lanish" FontSize="15" FontWeight="SemiBold"
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource NavLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <StackPanel x:Name="ContactDetailsPanel" Visibility="Collapsed"
                                Margin="12,2,0,8">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMainMenuExpanded}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Telefon: +998771577730"
                                   Foreground="#CBD5E1" FontSize="12"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Telegram: @bekmurodv_s"
                                   Foreground="#CBD5E1" FontSize="12" />
                    </StackPanel>
                    <Button Command="{Binding ShowLicenseCommand}" Height="58"
                            Tag="{Binding IsLicenseActive}" ToolTip="Litsenziya">
                        <Button.Style>
                            <Style BasedOn="{StaticResource NavButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMainMenuExpanded}" Value="True" />
                                            <Condition Binding="{Binding IsLicenseActive}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="#2563EB" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource NavIconStyle}">
                                <TextBlock Text="L" FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Litsenziya" FontSize="15" FontWeight="SemiBold"
                                           Style="{StaticResource NavLabelStyle}" />
                                <TextBlock Text="{Binding LicenseSummary}" FontSize="11" Opacity="0.8" Margin="0,2,0,0"
                                           Style="{StaticResource NavLabelStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- O'ng qism -->
        <Grid Grid.Column="1" Background="#F8FAFC">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- 0: TitleBar -->
                <!-- 1: litsenziya banneri -->
                <RowDefinition Height="Auto" />
                <!-- 2: sahifa -->
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <!-- 3: sotuv tablari -->
            </Grid.RowDefinitions>

            <ui:TitleBar Grid.Row="0" Title="" />

            <!-- Litsenziya banneri (14 kundan kam qolganda yoki muddat tugaganda) -->
            <Border Grid.Row="1" Margin="20,3,20,0" Padding="10,5" CornerRadius="8"
                    Visibility="{Binding ShowBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FEF3C7" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BannerIsError}" Value="True">
                                <Setter Property="Background" Value="#FEE2E2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Command="{Binding ShowLicenseCommand}"
                            Content="Litsenziya"
                            Margin="12,0,0,0"
                            Padding="10,4"
                            Cursor="Hand" />
                    <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" FontSize="12"
                               Foreground="#1E293B" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" Margin="20,6,20,8" />

            <!-- Sotuv tablari -->
            <Border Grid.Row="3"
                    Margin="20,0,20,14"
                    Padding="8,6"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding IsSaleActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Command="{Binding AddSaleSessionCommand}"
                            Content="+ Yangi sotuv"
                            Margin="8,0,0,0"
                            Padding="16,8"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ButtonBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#1D4ED8" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#1E40AF" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <ListBox ItemsSource="{Binding SaleSessions}"
                             SelectedItem="{Binding CurrentSaleSession, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="False">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,6,0" />
                                <Setter Property="Background" Value="#F1F5F9" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="TabBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="#DBEAFE" />
                                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="#93C5FD" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="#E2E8F0" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="12,7,7,7">
                                    <TextBlock Text="{Binding SessionTitle}"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#334155" />
                                    <Button Content="×"
                                            Command="{Binding DataContext.CloseSaleSessionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Margin="12,0,0,0"
                                            Padding="5,0"
                                            Background="Transparent"
                                            Foreground="#64748B"
                                            BorderThickness="0"
                                            FontSize="16"
                                            Cursor="Hand" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>