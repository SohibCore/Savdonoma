<ui:FluentWindow x:Class="Savdonoma.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="TijoratUz"
        Icon="pack://application:,,,/TijoratUz;component/TijoratUz.ico"
        Height="760" Width="1240"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Yon menyu tugmasi: ochiq holatda ikonka + matn, yopiq holatda markazlashgan kvadrat -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <Setter Property="ToolTipService.Placement" Value="Right" />
            <Setter Property="ToolTipService.HorizontalOffset" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bg"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Border>
                            <!-- Faol bo'lim indikatori -->
                            <Border x:Name="Indicator" Width="4" Height="22" CornerRadius="2"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="-2,0,0,0" Background="#60A5FA" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B" />
                    <Setter Property="Foreground" Value="#F1F5F9" />
                </Trigger>
                <!-- Faol bo'lim (Tag = true) -->
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#2563EB" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </DataTrigger>
                <!-- Yopiq menyu -->
                <DataTrigger Binding="{Binding IsMainMenuExpanded}" Value="False">
                    <Setter Property="Height" Value="48" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="4,0,4,6" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavIconStyle" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Width" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMainMenuExpanded}" Value="False">
                    <Setter Property="FontSize" Value="22" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMainMenuExpanded}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Faqat ochiq menyuda ko'rinadigan elementlar -->
        <Style x:Key="ExpandedOnlyStyle" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMainMenuExpanded}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Guruhlar orasidagi ajratkich -->
        <Style x:Key="NavSeparatorStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#1FFFFFFF" />
            <Setter Property="Margin" Value="8,8,8,10" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMainMenuExpanded}" Value="False">
                    <Setter Property="Margin" Value="14,6,14,10" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="12,0,0,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMainMenuExpanded}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Yon menyu -->
        <Border Grid.Column="0" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="256" />
                    <Setter Property="Padding" Value="16,14,16,16" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMainMenuExpanded}" Value="False">
                            <Setter Property="Width" Value="80" />
                            <Setter Property="Padding" Value="8,14,8,16" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0F172A" Offset="0" />
                    <GradientStop Color="#1E1B4B" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo va do'kon holati -->
                <StackPanel Grid.Row="0" Margin="0,4,0,0">
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="Margin" Value="4,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMainMenuExpanded}" Value="False">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#38BDF8" Offset="0" />
                                    <GradientStop Color="#6366F1" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Image Source="pack://application:,,,/TijoratUz;component/TijoratUzLogo.png"
                                   Width="40" Height="40" Stretch="Uniform"
                                   SnapsToDevicePixels="True"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Style="{StaticResource ExpandedOnlyStyle}">
                            <TextBlock Text="TijoratUz" Foreground="White" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="Savdo boshqaruvi" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,14,0,0" Style="{StaticResource ExpandedOnlyStyle}">
                        <Button Command="{Binding ChangeInventoryModeCommand}"
                                IsEnabled="{Binding IsOwner}"
                                Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                Padding="10,7" Margin="0,0,0,6" Cursor="Hand"
                                FocusVisualStyle="{x:Null}"
                                ToolTip="{Binding InventoryModeTooltip}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ModeBadge"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ModeBadge" Property="Background" Value="#334155" />
                                            <Setter TargetName="ModeBadge" Property="BorderBrush" Value="#60A5FA" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="ModeBadge" Property="Opacity" Value="0.7" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel>
                                <TextBlock Text="DO‘KON REJIMI" FontSize="10"
                                           FontWeight="Bold" Foreground="#94A3B8" />
                                <TextBlock Text="{Binding InventoryModeText}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#BFDBFE"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Button>
                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                CornerRadius="10" Padding="10,7">
                            <TextBlock Text="{Binding TodayText}" FontSize="12"
                                       FontWeight="SemiBold" Foreground="#CBD5E1" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Navigatsiya -->
                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <!-- Menyuni ochish/yopish -->
                    <Button Command="{Binding ToggleMainMenuCommand}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource NavButtonStyle}" TargetType="Button">
                                <Setter Property="Height" Value="40" />
                                <Setter Property="Margin" Value="0,0,0,2" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="ToolTip" Value="Menyuni yopish" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMainMenuExpanded}" Value="False">
                                        <Setter Property="Height" Value="44" />
                                        <Setter Property="Margin" Value="4,0,4,2" />
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="ToolTip" Value="Menyuni ochish" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <TextBlock Text="ASOSIY MENYU" Foreground="#64748B" FontSize="11" FontWeight="Bold"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Style="{StaticResource ExpandedOnlyStyle}" />
                            <ui:SymbolIcon Symbol="PanelLeftContract24" HorizontalAlignment="Right"
                                           FontSize="20" VerticalAlignment="Center"
                                           Style="{StaticResource ExpandedOnlyStyle}" />
                            <ui:SymbolIcon Symbol="PanelLeftExpand24" FontSize="22"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMainMenuExpanded}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </Grid>
                    </Button>

                    <Border Style="{StaticResource NavSeparatorStyle}" />

                    <Button Command="{Binding ShowSaleCommand}" Tag="{Binding IsSaleActive}"
                            ToolTip="Sotuv" Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Cart24" Style="{StaticResource NavIconStyle}" />
                            <TextBlock Text="Sotuv" Style="{StaticResource NavLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowProductsCommand}"
                            Visibility="{Binding IsOwner, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Tag="{Binding IsProductsActive}"
                            ToolTip="Mahsulotlar" Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Box24" Style="{StaticResource NavIconStyle}" />
                            <TextBlock Text="Mahsulotlar" Style="{StaticResource NavLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowWarehouseCommand}"
                            Visibility="{Binding CanManageStock, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Tag="{Binding IsWarehouseActive}"
                            ToolTip="Ombor" Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="BoxMultiple24" Style="{StaticResource NavIconStyle}" />
                            <TextBlock Text="Ombor" Style="{StaticResource NavLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowReportsCommand}" Tag="{Binding IsReportsActive}"
                            ToolTip="Hisobotlar" Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DataBarVertical24" Style="{StaticResource NavIconStyle}" />
                            <TextBlock Text="Hisobotlar" Style="{StaticResource NavLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowEmployeesCommand}"
                            Visibility="{Binding IsOwner, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Tag="{Binding IsEmployeesActive}"
                            ToolTip="Xodimlar" Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="People24" Style="{StaticResource NavIconStyle}" />
                            <TextBlock Text="Xodimlar" Style="{StaticResource NavLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowOrganizationCommand}"
                            Visibility="{Binding IsOwner, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Tag="{Binding IsOrganizationActive}"
                            ToolTip="Do‘kon va egasi ma’lumotlari" Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="BuildingShop24" Style="{StaticResource NavIconStyle}" />
                            <TextBlock Text="Do‘kon haqida" Style="{StaticResource NavLabelStyle}" />
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource NavSeparatorStyle}" />

                    <Button Click="ContactButton_Click" Style="{StaticResource NavButtonStyle}">
                        <Button.ToolTip>
                            <StackPanel>
                                <TextBlock Text="Bog‘lanish" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="Telefon: +998771577730" />
                                <TextBlock Text="Telegram: @bekmurodv_s" />
                            </StackPanel>
                        </Button.ToolTip>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Headset24" Style="{StaticResource NavIconStyle}"
                                           Foreground="#5EEAD4" />
                            <TextBlock Text="Bog‘lanish" Style="{StaticResource NavLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource ExpandedOnlyStyle}">
                        <Border x:Name="ContactDetailsPanel" Visibility="Collapsed"
                                Background="#14FFFFFF" CornerRadius="10"
                                Padding="12,8" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="Telefon: +998771577730"
                                           Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,4" />
                                <TextBlock Text="Telegram: @bekmurodv_s"
                                           Foreground="#CBD5E1" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </Border>
                </StackPanel>

                <!-- Menyu pastida: Litsenziya va chiqish -->
                <StackPanel Grid.Row="3">
                    <Border Style="{StaticResource NavSeparatorStyle}" />
                    <Button Command="{Binding ShowLicenseCommand}" Tag="{Binding IsLicenseActive}"
                            ToolTip="{Binding LicenseSummary}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource NavButtonStyle}" TargetType="Button">
                                <Setter Property="Height" Value="54" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMainMenuExpanded}" Value="False">
                                        <Setter Property="Height" Value="48" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" Style="{StaticResource NavIconStyle}" />
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"
                                        Style="{StaticResource ExpandedOnlyStyle}">
                                <TextBlock Text="Litsenziya" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding LicenseSummary}" FontSize="11" Opacity="0.75"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Click="ExitButton_Click" ToolTip="Dasturdan chiqish">
                        <Button.Style>
                            <Style BasedOn="{StaticResource NavButtonStyle}" TargetType="Button">
                                <Setter Property="Foreground" Value="#FCA5A5" />
                                <Setter Property="Margin" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMainMenuExpanded}" Value="False">
                                        <Setter Property="Margin" Value="4,0" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#7F1D1D" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="SignOut24" Style="{StaticResource NavIconStyle}" />
                            <TextBlock Text="Chiqish" Style="{StaticResource NavLabelStyle}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- O'ng qism -->
        <Grid Grid.Column="1" Background="#F8FAFC">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- 0: TitleBar -->
                <!-- 1: litsenziya banneri -->
                <RowDefinition Height="Auto" />
                <!-- 2: sahifa -->
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <!-- 3: sotuv tablari -->
            </Grid.RowDefinitions>

            <ui:TitleBar Grid.Row="0" Title="" />

            <!-- Litsenziya banneri (14 kundan kam qolganda yoki muddat tugaganda) -->
            <Border Grid.Row="1" Margin="20,3,20,0" Padding="10,5" CornerRadius="8"
                    Visibility="{Binding ShowBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FEF3C7" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BannerIsError}" Value="True">
                                <Setter Property="Background" Value="#FEE2E2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Command="{Binding ShowLicenseCommand}"
                            Content="Litsenziya"
                            Margin="12,0,0,0"
                            Padding="10,4"
                            Cursor="Hand" />
                    <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" FontSize="12"
                               Foreground="#1E293B" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" Margin="20,6,20,8" />

            <!-- Sotuv tablari -->
            <Border Grid.Row="3"
                    Margin="20,0,20,14"
                    Padding="8,6"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding IsSaleActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Command="{Binding AddSaleSessionCommand}"
                            Content="+ Yangi sotuv"
                            Margin="8,0,0,0"
                            Padding="16,8"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ButtonBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#1D4ED8" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#1E40AF" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <ListBox ItemsSource="{Binding SaleSessions}"
                             SelectedItem="{Binding CurrentSaleSession, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="False">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,6,0" />
                                <Setter Property="Background" Value="#F1F5F9" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="TabBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="#DBEAFE" />
                                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="#93C5FD" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="#E2E8F0" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="12,7,7,7">
                                    <TextBlock Text="{Binding SessionTitle}"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#334155" />
                                    <Button Content="×"
                                            Command="{Binding DataContext.CloseSaleSessionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Margin="12,0,0,0"
                                            Padding="5,0"
                                            Background="Transparent"
                                            Foreground="#64748B"
                                            BorderThickness="0"
                                            FontSize="16"
                                            Cursor="Hand" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>