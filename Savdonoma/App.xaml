<Application x:Class="Savdonoma.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Savdonoma.ViewModels"
             xmlns:views="clr-namespace:Savdonoma.Views"
             xmlns:wvm="clr-namespace:Savdonoma.ViewModels.Warehouse"
             xmlns:wviews="clr-namespace:Savdonoma.Views.Warehouse">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/TijoratUz;component/Styles/AppTheme.xaml" />
                <ResourceDictionary Source="/TijoratUz;component/Styles/TableStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="TableRowStyle" TargetType="ListViewItem">
                <Setter Property="BorderBrush" Value="#EEF2F6" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Background" Value="White" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F8FAFC" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#EFF6FF" />
                        <Setter Property="BorderBrush" Value="#DBEAFE" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <DataTemplate DataType="{x:Type vm:LicenseViewModel}">
                <views:LicenseView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SaleViewModel}">
                <views:SaleView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
                <views:ProductsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                <views:ReportsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:EmployeesViewModel}">
                <views:EmployeesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OrganizationViewModel}">
                <views:OrganizationView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type wvm:WarehouseViewModel}">
                <wviews:WarehouseView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>