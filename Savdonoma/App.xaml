<Application x:Class="Savdonoma.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Savdonoma.ViewModels"
             xmlns:views="clr-namespace:Savdonoma.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="TableRowStyle" TargetType="ListViewItem">
                <Setter Property="BorderBrush" Value="#E5E7EB" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>
            <DataTemplate DataType="{x:Type vm:LicenseViewModel}">
                <views:LicenseView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SaleViewModel}">
                <views:SaleView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
                <views:ProductsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                <views:ReportsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>